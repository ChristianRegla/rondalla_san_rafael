---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Sparkles, MapPin, Tag, ZoomIn, X } from "@lucide/astro";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params as { lang: "es" | "en" };

// Colección de Fotos con metadatos de Categoría, Lugar y Evento
const galleryData = [
  {
    id: 1,
    src: "/images/foto_album.webp",
    title:
      lang === "es"
        ? "Presentación de Gala Formal"
        : "Formal Gala Presentation",
    location: "Puerto Vallarta",
    category: "bodas",
    tag: lang === "es" ? "Boda de Gala" : "Gala Wedding",
  },
  {
    id: 2,
    src: "/images/galeria-1.webp",
    title:
      lang === "es"
        ? "Serenata Acústica al Atardecer"
        : "Sunset Acoustic Serenade",
    location: "Conchas Chinas",
    category: "serenatas",
    tag: lang === "es" ? "Serenata Sorpresa" : "Surprise Serenade",
  },
  {
    id: 3,
    src: "/images/galeria-2.webp",
    title:
      lang === "es"
        ? "Guitarras de Concierto en Maderas Nobles"
        : "Concert Tonewood Guitars",
    location: "Marina Vallarta",
    category: "bohemia",
    tag: lang === "es" ? "Noche Bohemia" : "Bohemian Night",
  },
  {
    id: 4,
    src: "/images/galeria-1.webp",
    title:
      lang === "es" ? "Enlace Nupcial en la Playa" : "Beach Wedding Serenade",
    location: "Sayulita",
    category: "bodas",
    tag: lang === "es" ? "Boda en Playa" : "Beach Wedding",
  },
  {
    id: 5,
    src: "/images/foto_album.webp",
    title: lang === "es" ? "Aniversario de Oro" : "Golden Anniversary",
    location: "Nuevo Vallarta",
    category: "serenatas",
    tag: lang === "es" ? "Aniversario" : "Anniversary",
  },
  {
    id: 6,
    src: "/images/galeria-2.webp",
    title:
      lang === "es" ? "Velada Bohemia Familiar" : "Family Bohemian Evening",
    location: "Punta de Mita",
    category: "bohemia",
    tag: lang === "es" ? "Reunión Familiar" : "Family Gathering",
  },
];

const filters = [
  { id: "all", label: lang === "es" ? "Todas las Fotos" : "All Photos" },
  { id: "serenatas", label: lang === "es" ? "Serenatas" : "Serenades" },
  { id: "bodas", label: lang === "es" ? "Bodas & Coctel" : "Weddings" },
  {
    id: "bohemia",
    label: lang === "es" ? "Noches Bohemias" : "Bohemian Nights",
  },
];
---

<Layout
  title={lang === "es"
    ? "Galería de Fotos | Rondalla San Rafael"
    : "Photo Gallery | Rondalla San Rafael"}
  lang={lang}
>
  <Header lang={lang} />

  <main class="pt-32 pb-24 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      {/* Encabezado */}
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-md"
        >
          <Sparkles class="w-3.5 h-3.5 text-amber-400" />
          <span
            >{lang === "es" ? "Acervo Fotográfico" : "Photo Collection"}</span
          >
        </div>
        <h1
          class="font-serif text-4xl sm:text-6xl font-extrabold text-stone-100 tracking-tight mb-4"
        >
          {
            lang === "es"
              ? "Galería de Eventos & Momentos"
              : "Gallery of Events & Moments"
          }
        </h1>
        <p
          class="text-stone-400 text-base sm:text-lg font-light leading-relaxed"
        >
          {
            lang === "es"
              ? "Explora nuestras presentaciones clasificadas por tipo de evento y locación en Puerto Vallarta y Riviera Nayarit."
              : "Browse through our performances categorized by event type and location."
          }
        </p>
      </div>

      {/* Botones de Filtro en Cristal */}
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
        {
          filters.map((filter, idx) => (
            <button
              type="button"
              data-filter={filter.id}
              class={`filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition-all duration-300 border ${
                idx === 0
                  ? "bg-amber-500/20 text-amber-300 border-amber-400/50 shadow-[0_0_15px_rgba(245,158,11,0.2)]"
                  : "liquid-glass-luthier text-stone-400 hover:text-stone-200 border-stone-800"
              }`}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      {/* Grid de Fotos */}
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        id="gallery-grid"
      >
        {
          galleryData.map((img) => (
            <div
              class="gallery-card group relative aspect-[4/3] rounded-3xl bg-[#140e0c] border border-stone-800/80 overflow-hidden shadow-xl hover:border-amber-500/50 transition-all duration-500 cursor-pointer"
              data-category={img.category}
              data-src={img.src}
              data-title={img.title}
              data-location={img.location}
            >
              <img
                src={img.src}
                alt={img.title}
                class="w-full h-full object-cover group-hover:scale-[1.06] transition-transform duration-700 ease-out filter brightness-90 group-hover:brightness-100"
              />

              <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/60 border border-white/15 text-stone-200 text-xs font-semibold backdrop-blur-md flex items-center gap-1.5">
                <Tag class="w-3 h-3 text-amber-400" />
                <span>{img.tag}</span>
              </div>

              <div class="absolute top-4 right-4 p-2.5 rounded-full bg-stone-950/60 border border-white/15 text-stone-300 opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-md shadow-lg">
                <ZoomIn class="w-4 h-4 text-amber-400" />
              </div>

              <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/40 to-transparent flex flex-col justify-end p-6">
                <h3 class="font-serif text-stone-100 text-lg font-bold drop-shadow-md leading-snug mb-1">
                  {img.title}
                </h3>
                <span class="flex items-center gap-1 text-xs text-amber-300 font-mono">
                  <MapPin class="w-3.5 h-3.5 text-amber-400" />
                  {img.location}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>

  {/* Lightbox Modal */}
  <div
    id="gallery-modal"
    class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-xl flex-col items-center justify-center p-4 transition-all duration-300"
  >
    <button
      id="modal-close"
      type="button"
      class="absolute top-6 right-6 p-3 rounded-full bg-stone-900/80 border border-stone-800 text-stone-300 hover:text-amber-400 transition-all"
    >
      <X class="w-6 h-6" />
    </button>
    <div class="max-w-4xl w-full flex flex-col items-center">
      <img
        id="modal-img"
        src=""
        alt=""
        class="max-w-full max-h-[75vh] object-contain rounded-2xl border border-stone-800 shadow-2xl"
      />
      <h3
        id="modal-title"
        class="mt-4 font-serif text-stone-100 text-xl font-bold text-center"
      >
      </h3>
      <p
        id="modal-loc"
        class="text-amber-400 font-mono text-xs mt-1 flex items-center gap-1"
      >
      </p>
    </div>
  </div>

  <Footer lang={lang} />
  <WhatsAppButton lang={lang} />
</Layout>

<script>
  // Script de filtrado interactivo
  const filterBtns = document.querySelectorAll(".filter-btn");
  const galleryCards = document.querySelectorAll(".gallery-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");

      // Cambiar clases de estilo activo
      filterBtns.forEach((b) => {
        b.classList.remove(
          "bg-amber-500/20",
          "text-amber-300",
          "border-amber-400/50",
          "shadow-[0_0_15px_rgba(245,158,11,0.2)]",
        );
        b.classList.add(
          "liquid-glass-luthier",
          "text-stone-400",
          "border-stone-800",
        );
      });
      btn.classList.remove(
        "liquid-glass-luthier",
        "text-stone-400",
        "border-stone-800",
      );
      btn.classList.add(
        "bg-amber-500/20",
        "text-amber-300",
        "border-amber-400/50",
        "shadow-[0_0_15px_rgba(245,158,11,0.2)]",
      );

      // Filtrar tarjetas
      galleryCards.forEach((card) => {
        const category = card.getAttribute("data-category");
        if (filter === "all" || category === filter) {
          (card as HTMLElement).style.display = "block";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Modal Lightbox
  const modal = document.getElementById("gallery-modal");
  const modalImg = document.getElementById("modal-img") as HTMLImageElement;
  const modalTitle = document.getElementById("modal-title");
  const modalLoc = document.getElementById("modal-loc");
  const modalClose = document.getElementById("modal-close");

  galleryCards.forEach((card) => {
    card.addEventListener("click", () => {
      if (!modal || !modalImg) return;
      modalImg.src = card.getAttribute("data-src") || "";
      if (modalTitle)
        modalTitle.textContent = card.getAttribute("data-title") || "";
      if (modalLoc)
        modalLoc.textContent = card.getAttribute("data-location") || "";
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    });
  });

  modalClose?.addEventListener("click", () => {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  });
</script>
