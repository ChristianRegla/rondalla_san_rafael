---
import {
  Play,
  Pause,
  SkipForward,
  SkipBack,
  Volume2,
  VolumeX,
  Music2,
  Sparkles,
  X,
  ZoomIn,
  Video,
} from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { REPERTOIRE_TRACKS } from "../config/repertoire";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const foto_album = "/images/foto_album.webp";
const tracks = REPERTOIRE_TRACKS;

const galleryImages = [
  {
    alt: "Rondalla San Rafael - Retrato Oficial de Gala",
    src: "/images/foto_album.webp",
    caption:
      lang === "es"
        ? "Presentación de gala formal: 12 músicos en smoking de etiqueta en Puerto Vallarta."
        : "Formal Gala Presentation: 12 musicians in tuxedo in Puerto Vallarta.",
    tag: lang === "es" ? "Gala de Etiqueta" : "Formal Gala",
  },
  {
    alt: "Rondalla San Rafael en vivo en Puerto Vallarta",
    src: "/images/galeria-1.webp",
    caption:
      lang === "es"
        ? "Serenata acústica tradicional: guitarras, requintos y contrabajo de madera noble."
        : "Traditional acoustic serenade: guitars, requintos, and double bass.",
    tag: lang === "es" ? "Serenata en Vivo" : "Live Serenade",
  },
  {
    alt: "Instrumentos de luthería y guitarras de concierto",
    src: "/images/galeria-2.webp",
    caption:
      lang === "es"
        ? "Nuestros instrumentos de concierto: maderas nobles de cedro, abeto y palisandro."
        : "Our concert instruments: noble cedar, spruce, and rosewood tonewoods.",
    tag: lang === "es" ? "Maderas Nobles" : "Noble Tonewoods",
  },
];
---

<section
  id="media"
  class="py-16 sm:py-24 bg-[#0b0807] border-t border-amber-950/20 relative overflow-hidden"
>
  {/* Auras de resonancia armónica */}
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] sm:w-[700px] h-[350px] sm:h-[450px] bg-amber-600/[0.07] blur-[150px] pointer-events-none rounded-full"
    style="transform: translateX(-50%) translateZ(0);"
  >
  </div>
  <div
    class="absolute bottom-10 left-10 w-80 sm:w-96 h-80 sm:h-96 bg-[#8a3a17]/[0.08] blur-[130px] pointer-events-none rounded-full"
    style="transform: translateZ(0);"
  >
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    {/* Encabezado Editorial */}
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-[11px] sm:text-xs font-semibold uppercase tracking-widest mb-3 sm:mb-4 backdrop-blur-md shadow-sm"
      >
        <Sparkles class="w-3.5 h-3.5 text-amber-400" />
        <span>
          {
            lang === "es"
              ? "Colección Acústica de Estudio"
              : "Studio Acoustic Collection"
          }
        </span>
      </div>
      <h2
        class="font-serif text-3xl sm:text-5xl md:text-6xl font-extrabold text-stone-100 tracking-tight mb-3 sm:mb-5 leading-tight"
      >
        {
          lang === "es"
            ? "Repertorio & Galería de Gala"
            : "Repertoire & Gala Gallery"
        }
      </h2>
      <p class="text-stone-300 text-xs sm:text-base font-light leading-relaxed">
        {
          lang === "es"
            ? "Grabaciones directas de estudio. Escucha la pureza de las cuerdas de nylon, los requintos y las armonías vocales de la Rondalla San Rafael."
            : "Direct studio recordings. Listen to the warmth of nylon strings, intricate requintos, and signature vocal harmonies of Rondalla San Rafael."
        }
      </p>
    </div>

    {/* Reproductor: Cámara de Resonancia */}
    <div
      class="liquid-glass-card rounded-2xl sm:rounded-[32px] p-4 sm:p-8 md:p-10 mb-12 sm:mb-16 relative overflow-hidden"
    >
      <div
        class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 lg:gap-12 items-center"
      >
        {/* Lado Izquierdo: Visualizador & Controles */}
        <div class="md:col-span-5 flex flex-col items-center text-center">
          {/* Roseta de Luthería */}
          <div
            class="relative w-36 h-36 sm:w-52 sm:h-52 md:w-56 md:h-56 lg:w-64 lg:h-64 mb-3 sm:mb-5 flex items-center justify-center shrink-0"
          >
            <div
              id="acoustic-wave-1"
              class="absolute inset-0 rounded-full border border-amber-500/0 pointer-events-none transition-all duration-700"
            >
            </div>
            <div
              id="acoustic-wave-2"
              class="absolute -inset-3 rounded-full border border-amber-400/0 pointer-events-none transition-all duration-1000"
            >
            </div>
            <div
              id="rosette-glow"
              class="absolute -inset-2 rounded-full bg-amber-500/0 blur-2xl pointer-events-none transition-all duration-700"
            >
            </div>

            <div
              id="rosette-disc"
              class="w-full h-full rounded-full p-2 sm:p-3 relative flex items-center justify-center shadow-[0_20px_50px_rgba(0,0,0,0.85)] border border-amber-500/30 transition-all duration-700"
              style="background: radial-gradient(circle at center, transparent 48%, rgba(41,37,36,0.9) 49%, transparent 50%, transparent 57%, rgba(217,119,6,0.25) 58%, transparent 59%, transparent 68%, rgba(251,191,36,0.3) 69%, transparent 70%, transparent 80%, rgba(245,158,11,0.4) 81%, transparent 82%), linear-gradient(135deg, #241713, #140e0c, #090605);"
            >
              <div
                class="w-24 h-24 sm:w-36 sm:h-36 md:w-40 md:h-40 rounded-full bg-gradient-to-b from-[#060403] via-[#0b0807] to-[#040302] border-2 border-amber-500/30 flex items-center justify-center relative shadow-[inset_0_12px_32px_rgba(0,0,0,0.95)] overflow-hidden"
              >
                <div
                  id="guitar-strings"
                  class="absolute inset-x-0 h-full flex justify-center items-stretch gap-2 sm:gap-3.5 pointer-events-none opacity-50 z-10 transition-opacity"
                >
                  <span
                    class="string-line string-6 w-[2.2px] bg-gradient-to-b from-amber-700 via-amber-400 to-amber-700 origin-center"
                  ></span>
                  <span
                    class="string-line string-5 w-[1.8px] bg-gradient-to-b from-amber-600 via-amber-300 to-amber-600 origin-center"
                  ></span>
                  <span
                    class="string-line string-4 w-[1.5px] bg-gradient-to-b from-amber-500 via-amber-200 to-amber-500 origin-center"
                  ></span>
                  <span
                    class="string-line string-3 w-[1.2px] bg-gradient-to-b from-stone-400 via-white/90 to-stone-400 origin-center"
                  ></span>
                  <span
                    class="string-line string-2 w-[1.0px] bg-gradient-to-b from-stone-400 via-white to-stone-400 origin-center"
                  ></span>
                  <span
                    class="string-line string-1 w-[0.8px] bg-gradient-to-b from-stone-300 via-white to-stone-300 origin-center"
                  ></span>
                </div>

                <div
                  class="w-16 h-16 sm:w-24 sm:h-24 md:w-26 md:h-26 rounded-full border-2 border-amber-400/40 flex items-center justify-center relative z-20 shadow-2xl overflow-hidden group"
                >
                  <img
                    src={foto_album}
                    alt="Rondalla San Rafael"
                    class="w-full h-full object-cover filter brightness-95 group-hover:scale-105 transition-transform duration-700"
                  />
                </div>
              </div>
            </div>

            <div
              id="loading-spinner"
              class="hidden absolute inset-0 rounded-full items-center justify-center pointer-events-none z-30"
            >
              <div
                class="w-10 h-10 rounded-full border-2 border-amber-400/20 border-t-amber-400 animate-spin"
              >
              </div>
            </div>
          </div>

          {/* Estado & Metadatos */}
          <div class="flex items-center gap-1.5 mb-1 justify-center">
            <span
              id="playing-dot"
              class="w-2 h-2 rounded-full bg-amber-500/40 transition-colors shrink-0"
            ></span>
            <span
              id="current-track-genre"
              class="text-[10px] sm:text-xs font-semibold text-amber-300/90 uppercase tracking-widest truncate"
            >
              {tracks[0].genre}
            </span>
          </div>

          <h3
            id="current-track-title"
            class="font-serif text-lg sm:text-2xl md:text-3xl font-extrabold text-stone-100 mb-1 max-w-full truncate px-2"
          >
            {tracks[0].title}
          </h3>

          <p
            id="current-track-desc"
            class="text-[11px] sm:text-xs text-stone-400 font-light max-w-xs mx-auto mb-4 leading-relaxed line-clamp-2"
          >
            {
              tracks[0].description?.[lang] ||
                "Rondalla San Rafael de Puerto Vallarta"
            }
          </p>

          {/* Controles Principales */}
          <div class="w-full max-w-xs mx-auto space-y-3">
            <div class="space-y-1">
              <div
                id="progress-container"
                class="w-full h-2 bg-[#090605] border border-stone-800/80 rounded-full cursor-pointer relative overflow-hidden group shadow-inner"
                role="slider"
                tabindex="0"
                aria-label={lang === "es"
                  ? "Progreso de la canción"
                  : "Track progress"}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <div
                  id="progress-bar"
                  class="h-full bg-gradient-to-r from-amber-600 via-amber-500 to-amber-300 rounded-full w-0 transition-all duration-100 relative"
                >
                  <div
                    class="absolute right-0 top-1/2 -translate-y-1/2 w-2.5 h-2.5 bg-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-md"
                  >
                  </div>
                </div>
              </div>

              <div
                class="flex justify-between text-[10px] sm:text-[11px] font-mono text-stone-400"
              >
                <span id="current-time">0:00</span>
                <span id="total-duration">{tracks[0].duration}</span>
              </div>
            </div>

            <div class="flex items-center justify-center gap-4 sm:gap-5 w-full">
              <button
                id="prev-btn"
                type="button"
                aria-label={lang === "es"
                  ? "Canción anterior"
                  : "Previous track"}
                class="p-2 sm:p-2.5 rounded-full text-stone-400 hover:text-amber-300 hover:bg-white/5 border border-transparent hover:border-white/10 transition-all shrink-0 flex items-center justify-center"
              >
                <SkipBack class="w-4 h-4 sm:w-5 sm:h-5" />
              </button>
              <button
                id="play-btn"
                type="button"
                aria-label={lang === "es"
                  ? "Reproducir o pausar"
                  : "Play or pause"}
                class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-gradient-to-tr from-amber-600 via-amber-500 to-amber-400 hover:from-amber-500 hover:to-amber-300 text-stone-950 flex items-center justify-center shadow-lg shadow-amber-600/30 hover:scale-105 active:scale-95 transition-all border border-amber-300/40 shrink-0"
              >
                <Play
                  id="play-icon"
                  class="w-5 h-5 sm:w-6 sm:h-6 fill-current ml-0.5"
                />
                <Pause
                  id="pause-icon"
                  class="w-5 h-5 sm:w-6 sm:h-6 fill-current hidden"
                />
              </button>
              <button
                id="next-btn"
                type="button"
                aria-label={lang === "es" ? "Siguiente canción" : "Next track"}
                class="p-2 sm:p-2.5 rounded-full text-stone-400 hover:text-amber-300 hover:bg-white/5 border border-transparent hover:border-white/10 transition-all shrink-0 flex items-center justify-center"
              >
                <SkipForward class="w-4 h-4 sm:w-5 sm:h-5" />
              </button>
            </div>

            <div class="flex items-center gap-2 pt-1">
              <button
                id="mute-btn"
                type="button"
                aria-label={lang === "es" ? "Silenciar" : "Mute"}
                class="text-stone-400 hover:text-amber-300 transition-colors shrink-0"
              >
                <Volume2 id="volume-icon" class="w-4 h-4" />
                <VolumeX id="mute-icon" class="w-4 h-4 hidden" />
              </button>
              <input
                id="volume-slider"
                type="range"
                min="0"
                max="100"
                value="80"
                aria-label={lang === "es" ? "Volumen" : "Volume"}
                class="volume-range w-full h-1.5 rounded-full appearance-none bg-stone-900 cursor-pointer border border-stone-800/80"
              />
            </div>
          </div>
        </div>

        {/* Lado Derecho: Lista de Reproducción */}
        <div
          class="md:col-span-7 flex flex-col h-full justify-between border-t md:border-t-0 md:border-l border-stone-800/70 pt-5 md:pt-0 md:pl-8 lg:pl-10"
        >
          {/* Cabecera */}
          <div
            class="flex items-center justify-between gap-2 pb-3 mb-3 sm:pb-4 sm:mb-4 border-b border-stone-800/70"
          >
            <h4
              class="font-serif text-base sm:text-lg md:text-xl font-bold text-stone-100 flex items-center gap-2 truncate min-w-0"
            >
              <Music2 class="w-4 h-4 sm:w-5 sm:h-5 text-amber-400 shrink-0" />
              <span class="truncate">
                {
                  lang === "es"
                    ? "Repertorio Seleccionado"
                    : "Selected Repertoire"
                }
              </span>
            </h4>
            <span
              class="text-[10px] sm:text-xs text-amber-300/80 font-mono tracking-wider bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20 shrink-0 whitespace-nowrap"
            >
              14 {lang === "es" ? "obras" : "tracks"}
            </span>
          </div>

          {/* Lista de Canciones */}
          <div
            class="space-y-1.5 sm:space-y-2 max-h-[280px] sm:max-h-[320px] md:max-h-[360px] lg:max-h-[400px] overflow-y-auto pr-1.5 sm:pr-2 custom-scrollbar"
          >
            {
              tracks.map((track, idx) => (
                <div class="relative group/track flex items-center gap-1.5">
                  <button
                    type="button"
                    data-index={idx}
                    data-src={track.src}
                    data-title={track.title}
                    data-genre={track.genre}
                    data-duration={track.duration}
                    data-desc={track.description?.[lang] || ""}
                    aria-current={idx === 0 ? "true" : "false"}
                    class="track-btn w-full flex items-center justify-between p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl bg-[#140e0c]/60 border border-stone-800/60 hover:border-amber-500/40 hover:bg-[#1f1511] transition-all text-left group relative overflow-hidden"
                  >
                    <div class="flex items-center gap-2.5 sm:gap-3.5 relative z-10 min-w-0 pr-2 sm:pr-3">
                      <span class="track-number w-5 sm:w-6 text-[11px] sm:text-xs font-mono font-semibold text-stone-400 group-hover:text-amber-400 transition-colors shrink-0">
                        {String(idx + 1).padStart(2, "0")}
                      </span>
                      <div class="truncate">
                        <span class="track-name font-serif text-xs sm:text-sm md:text-base font-bold text-stone-200 group-hover:text-amber-300 transition-colors block truncate leading-tight">
                          {track.title}
                        </span>
                        <span class="text-[10px] sm:text-[11px] text-stone-400 font-light block truncate">
                          {track.genre}
                        </span>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 sm:gap-3 relative z-10 shrink-0">
                      <div class="wave-equalizer hidden items-end gap-1 h-3.5">
                        <span class="w-0.5 h-full bg-amber-400 rounded-full" />
                        <span class="w-0.5 h-full bg-amber-400 rounded-full" />
                        <span class="w-0.5 h-full bg-amber-400 rounded-full" />
                      </div>
                      <span class="text-[10px] sm:text-xs text-stone-400 font-mono group-hover:text-stone-300 transition-colors">
                        {track.duration}
                      </span>
                    </div>
                  </button>

                  {/* Botón hacia el video en Galería (solo si la canción cuenta con 'videoUrl') */}
                  {track.videoUrl && (
                    <div class="relative group/video shrink-0">
                      <a
                        href={track.videoUrl}
                        class="p-2.5 rounded-xl sm:rounded-2xl bg-amber-500/10 hover:bg-amber-500/25 border border-amber-500/30 text-amber-300 hover:text-amber-200 transition-all flex items-center justify-center"
                        title={
                          lang === "es"
                            ? "Ver ensayo en video (Galería)"
                            : "Watch rehearsal video (Gallery)"
                        }
                      >
                        <Video class="w-4 h-4" />
                      </a>

                      {/* Tooltip Aclaratorio de Calidad */}
                      <div class="absolute right-0 bottom-full mb-2 hidden group-hover/video:block z-30 w-52 p-2.5 rounded-xl bg-stone-950/95 border border-amber-500/40 text-[10px] text-stone-300 font-light shadow-xl backdrop-blur-md pointer-events-none">
                        <p class="leading-tight">
                          <strong class="text-amber-300 block mb-0.5">
                            {lang === "es"
                              ? "Video de Ensayo"
                              : "Rehearsal Video"}
                          </strong>
                          {lang === "es"
                            ? "Muestra de ensayo con calidad de audio reducida. No representa el audio final en vivo."
                            : "Rehearsal snippet with reduced audio quality. Not representative of live audio."}
                        </p>
                      </div>
                    </div>
                  )}
                </div>
              ))
            }
          </div>

          <p
            class="text-[10px] sm:text-xs text-stone-400 mt-3 sm:mt-5 text-center md:text-left leading-relaxed font-light"
          >
            * {
              lang === "es"
                ? "Grabaciones originales interpretadas con requintos solistas, guitarras y armonías vocales por Rondalla San Rafael."
                : "Original recordings performed on concert guitars and signature multi-part vocal harmonies by Rondalla San Rafael."
            }
          </p>
        </div>
      </div>
    </div>

    {/* Tríptico de Galería de Gala */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {
        galleryImages.map((img) => (
          <button
            type="button"
            class="gallery-item group relative aspect-[4/3] rounded-2xl sm:rounded-3xl bg-[#140e0c] border border-stone-800/80 overflow-hidden shadow-xl hover:border-amber-500/50 transition-all duration-500 text-left cursor-zoom-in w-full focus:outline-none"
            data-src={img.src}
            data-alt={img.alt}
            data-caption={img.caption || ""}
          >
            <img
              src={img.src}
              alt={img.alt}
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-[1.06] transition-transform duration-700 ease-out filter brightness-90 group-hover:brightness-100"
            />
            <div class="absolute top-3 left-3 sm:top-4 sm:left-4 px-2.5 py-1 rounded-full bg-black/60 border border-white/15 text-stone-200 text-[10px] sm:text-xs font-semibold backdrop-blur-md">
              {img.tag}
            </div>
            <div class="absolute top-3 right-3 sm:top-4 sm:right-4 p-2 sm:p-2.5 rounded-full bg-stone-950/60 border border-white/15 text-stone-300 opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-md shadow-lg">
              <ZoomIn class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-400" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/40 to-transparent group-hover:via-stone-950/50 transition-all duration-300 flex items-end p-4 sm:p-6">
              <span class="font-serif text-stone-100 text-xs sm:text-base font-bold transform translate-y-0 group-hover:-translate-y-0.5 transition-transform duration-300 drop-shadow-md leading-snug">
                {img.caption}
              </span>
            </div>
          </button>
        ))
      }
    </div>
  </div>
</section>

{/* Lightbox Modal */}
<div
  id="lightbox-modal"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-xl flex-col items-center justify-center p-4 sm:p-8 transition-all duration-300"
>
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-4 right-4 sm:top-6 sm:right-6 p-2.5 sm:p-3 rounded-full bg-stone-900/80 border border-stone-800 text-stone-300 hover:text-amber-400 hover:bg-stone-800 transition-all z-10"
    aria-label={lang === "es" ? "Cerrar imagen" : "Close image"}
  >
    <X class="w-5 h-5 sm:w-6 sm:h-6" />
  </button>
  <div
    class="relative max-w-5xl w-full max-h-[85vh] flex flex-col items-center justify-center"
  >
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[75vh] object-contain rounded-2xl border border-stone-800/80 shadow-2xl"
    />
    <p
      id="lightbox-caption"
      class="mt-4 font-serif text-stone-200 text-sm sm:text-lg font-medium text-center hidden max-w-2xl px-4"
    >
    </p>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(22, 16, 13, 0.5);
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(212, 163, 89, 0.3);
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(212, 163, 89, 0.6);
  }

  @keyframes wave {
    0%,
    100% {
      transform: scaleY(0.2);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .wave-equalizer span:nth-child(1) {
    animation: wave 0.8s infinite ease-in-out;
    animation-play-state: paused;
    transform-origin: bottom;
  }
  .wave-equalizer span:nth-child(2) {
    animation: wave 0.8s infinite ease-in-out 0.2s;
    animation-play-state: paused;
    transform-origin: bottom;
  }
  .wave-equalizer span:nth-child(3) {
    animation: wave 0.8s infinite ease-in-out 0.4s;
    animation-play-state: paused;
    transform-origin: bottom;
  }
  .wave-equalizer.is-animating span {
    animation-play-state: running;
  }

  .volume-range {
    accent-color: #d4a359;
  }
  .volume-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #d4a359;
    box-shadow: 0 0 8px rgba(212, 163, 89, 0.8);
    cursor: pointer;
  }
  .volume-range::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: none;
    border-radius: 50%;
    background: #d4a359;
    box-shadow: 0 0 8px rgba(212, 163, 89, 0.8);
    cursor: pointer;
  }

  .track-active-glow {
    border-color: rgba(212, 163, 89, 0.5) !important;
    background: #241814 !important;
    box-shadow: 0 0 20px -4px rgba(212, 163, 89, 0.25);
  }

  .string-line {
    transition:
      transform 0.06s cubic-bezier(0.2, 0.8, 0.4, 1),
      filter 0.08s ease,
      opacity 0.3s ease;
    will-change: transform, filter;
  }

  .track-btn:focus-visible,
  #play-btn:focus-visible,
  #prev-btn:focus-visible,
  #next-btn:focus-visible,
  #mute-btn:focus-visible,
  #progress-container:focus-visible,
  .volume-range:focus-visible {
    outline: none !important;
    border-color: rgba(251, 191, 36, 0.8) !important;
    box-shadow:
      0 0 0 3px rgba(245, 158, 11, 0.35),
      0 0 15px rgba(245, 158, 11, 0.2) !important;
  }
</style>

<script>
  declare global {
    interface Window {
      __audioCtx?: AudioContext;
      __analyser?: AnalyserNode;
      __audioSourceNode?: MediaElementAudioSourceNode;
      __mediaVisualizerAnimId?: number | null;
    }
  }

  let currentIndex = 0;
  let isAudioCtxReady = false;
  let dataArray: Uint8Array<ArrayBuffer> | null = null;
  let lastVolume = 0.8;

  const vibrateMobile = () => {
    if ("vibrate" in navigator) {
      navigator.vibrate(15);
    }
  };

  const getAudioElements = () => {
    return {
      player: document.getElementById(
        "main-audio-player",
      ) as HTMLAudioElement | null,
      trackButtons: document.querySelectorAll(".track-btn"),
      titleDisplay: document.getElementById("current-track-title"),
      genreDisplay: document.getElementById("current-track-genre"),
      descDisplay: document.getElementById("current-track-desc"),
      totalDurationDisplay: document.getElementById("total-duration"),
      currentTimeDisplay: document.getElementById("current-time"),
      progressBar: document.getElementById("progress-bar"),
      progressContainer: document.getElementById("progress-container"),
      loadingSpinner: document.getElementById("loading-spinner"),
      playingDot: document.getElementById("playing-dot"),
      playBtn: document.getElementById("play-btn"),
      playIcon: document.getElementById("play-icon"),
      pauseIcon: document.getElementById("pause-icon"),
      prevBtn: document.getElementById("prev-btn"),
      nextBtn: document.getElementById("next-btn"),
      muteBtn: document.getElementById("mute-btn"),
      volumeIcon: document.getElementById("volume-icon"),
      muteIcon: document.getElementById("mute-icon"),
      volumeSlider: document.getElementById(
        "volume-slider",
      ) as HTMLInputElement | null,
      rosetteGlow: document.getElementById("rosette-glow"),
      wave1: document.getElementById("acoustic-wave-1"),
      wave2: document.getElementById("acoustic-wave-2"),
      guitarStrings: document.getElementById("guitar-strings"),
      stringEl6: document.querySelector(".string-6") as HTMLElement | null,
      stringEl5: document.querySelector(".string-5") as HTMLElement | null,
      stringEl4: document.querySelector(".string-4") as HTMLElement | null,
      stringEl3: document.querySelector(".string-3") as HTMLElement | null,
      stringEl2: document.querySelector(".string-2") as HTMLElement | null,
      stringEl1: document.querySelector(".string-1") as HTMLElement | null,
      lightboxModal: document.getElementById("lightbox-modal"),
      lightboxImg: document.getElementById(
        "lightbox-img",
      ) as HTMLImageElement | null,
      lightboxCaption: document.getElementById("lightbox-caption"),
      lightboxClose: document.getElementById("lightbox-close"),
      galleryItems: document.querySelectorAll(".gallery-item"),
    };
  };

  const initWebAudio = (player: HTMLAudioElement) => {
    if (isAudioCtxReady && window.__audioCtx && window.__analyser) return;
    try {
      const AudioContextClass =
        window.AudioContext ||
        (window as unknown as { webkitAudioContext: typeof AudioContext })
          .webkitAudioContext;
      if (!AudioContextClass) return;

      let ctx = window.__audioCtx;
      if (!ctx) {
        ctx = new AudioContextClass();
        window.__audioCtx = ctx;
      }

      let analyser = window.__analyser;
      if (!analyser) {
        analyser = ctx.createAnalyser();
        analyser.fftSize = 128;
        analyser.smoothingTimeConstant = 0.84;
        window.__analyser = analyser;
      }

      if (!window.__audioSourceNode && player) {
        const source = ctx.createMediaElementSource(player);
        source.connect(analyser);
        analyser.connect(ctx.destination);
        window.__audioSourceNode = source;
      }

      const buffer = new ArrayBuffer(analyser.frequencyBinCount);
      dataArray = new Uint8Array(buffer);
      isAudioCtxReady = true;
    } catch (err) {
      console.warn("Web Audio API en modo seguro:", err);
    }
  };

  const runAudioVisualizer = () => {
    const analyser = window.__analyser;
    const { player } = getAudioElements();
    if (!analyser || !dataArray || !player || player.paused) return;

    analyser.getByteFrequencyData(dataArray);

    const bass = (dataArray[1] + dataArray[2] + dataArray[3]) / (3 * 255);
    const midBass =
      (dataArray[4] + dataArray[5] + dataArray[6] + dataArray[7]) / (4 * 255);
    const lowMid = (dataArray[8] + dataArray[10] + dataArray[12]) / (3 * 255);
    const mid = (dataArray[14] + dataArray[17] + dataArray[20]) / (3 * 255);
    const high = (dataArray[22] + dataArray[26] + dataArray[30]) / (3 * 255);
    const treble = (dataArray[32] + dataArray[38] + dataArray[45]) / (3 * 255);
    const energy =
      (bass * 1.4 + midBass + lowMid + mid + high * 1.1 + treble * 1.3) / 6.8;

    const isMobile = window.innerWidth < 768;
    const {
      stringEl6,
      stringEl5,
      stringEl4,
      stringEl3,
      stringEl2,
      stringEl1,
      rosetteGlow,
      wave1,
      wave2,
      trackButtons,
    } = getAudioElements();

    if (stringEl6) {
      stringEl6.style.transform = `scaleX(${1 + bass * 3.4})`;
      stringEl6.style.filter = isMobile
        ? "none"
        : `brightness(${1 + bass * 1.3}) drop-shadow(0 0 ${bass * 8}px rgba(228, 181, 98, 0.75))`;
    }
    if (stringEl5) {
      stringEl5.style.transform = `scaleX(${1 + midBass * 3.0})`;
      stringEl5.style.filter = isMobile
        ? "none"
        : `brightness(${1 + midBass * 1.25}) drop-shadow(0 0 ${midBass * 7}px rgba(228, 181, 98, 0.65))`;
    }
    if (stringEl4) {
      stringEl4.style.transform = `scaleX(${1 + lowMid * 2.6})`;
      stringEl4.style.filter = isMobile
        ? "none"
        : `brightness(${1 + lowMid * 1.2}) drop-shadow(0 0 ${lowMid * 6}px rgba(207, 154, 72, 0.6))`;
    }
    if (stringEl3) {
      stringEl3.style.transform = `scaleX(${1 + mid * 2.3})`;
      stringEl3.style.filter = isMobile
        ? "none"
        : `brightness(${1 + mid * 1.4}) drop-shadow(0 0 ${mid * 7}px rgba(255, 255, 255, 0.75))`;
    }
    if (stringEl2) {
      stringEl2.style.transform = `scaleX(${1 + high * 2.1})`;
      stringEl2.style.filter = isMobile
        ? "none"
        : `brightness(${1 + high * 1.5}) drop-shadow(0 0 ${high * 8}px rgba(255, 255, 255, 0.85))`;
    }
    if (stringEl1) {
      stringEl1.style.transform = `scaleX(${1 + treble * 2.0})`;
      stringEl1.style.filter = isMobile
        ? "none"
        : `brightness(${1 + treble * 1.6}) drop-shadow(0 0 ${treble * 9}px rgba(255, 255, 255, 0.95))`;
    }

    if (rosetteGlow) {
      rosetteGlow.style.transform = `scale(${1 + energy * 0.18})`;
      rosetteGlow.style.opacity = String(0.18 + energy * 0.75);
    }
    if (wave1) {
      wave1.style.transform = `scale(${0.98 + energy * 0.09})`;
      wave1.style.borderColor = `rgba(228, 181, 98, ${0.12 + energy * 0.65})`;
    }
    if (wave2) {
      wave2.style.transform = `scale(${0.96 + energy * 0.14})`;
      wave2.style.borderColor = `rgba(207, 154, 72, ${0.08 + energy * 0.5})`;
    }

    const activeBtn = trackButtons[currentIndex];
    if (activeBtn) {
      const eqBars = activeBtn.querySelectorAll(".wave-equalizer span");
      if (eqBars.length === 3) {
        (eqBars[0] as HTMLElement).style.transform =
          `scaleY(${0.2 + bass * 0.8})`;
        (eqBars[1] as HTMLElement).style.transform =
          `scaleY(${0.22 + mid * 0.78})`;
        (eqBars[2] as HTMLElement).style.transform =
          `scaleY(${0.18 + treble * 0.82})`;
      }
    }

    const headerBars = document.querySelectorAll("#header-eq-bars .eq-bar");
    if (headerBars.length === 3) {
      (headerBars[0] as HTMLElement).style.transform =
        `scaleY(${0.3 + bass * 0.9})`;
      (headerBars[1] as HTMLElement).style.transform =
        `scaleY(${0.35 + mid * 1.0})`;
      (headerBars[2] as HTMLElement).style.transform =
        `scaleY(${0.28 + treble * 0.85})`;
    }

    const heroBars = document.querySelectorAll("#hero-eq-bars .eq-hero-bar");
    if (heroBars.length === 3) {
      (heroBars[0] as HTMLElement).style.transform =
        `scaleY(${0.3 + bass * 0.9})`;
      (heroBars[1] as HTMLElement).style.transform =
        `scaleY(${0.35 + mid * 1.0})`;
      (heroBars[2] as HTMLElement).style.transform =
        `scaleY(${0.28 + treble * 0.85})`;
    }

    if (!player.paused) {
      window.__mediaVisualizerAnimId =
        requestAnimationFrame(runAudioVisualizer);
    }
  };

  const startVisualizer = () => {
    const { player } = getAudioElements();
    if (!player) return;
    initWebAudio(player);
    if (window.__audioCtx && window.__audioCtx.state === "suspended") {
      window.__audioCtx.resume();
    }
    if (window.__mediaVisualizerAnimId) {
      cancelAnimationFrame(window.__mediaVisualizerAnimId);
    }
    window.__mediaVisualizerAnimId = requestAnimationFrame(runAudioVisualizer);
  };

  const stopVisualizer = () => {
    if (window.__mediaVisualizerAnimId) {
      cancelAnimationFrame(window.__mediaVisualizerAnimId);
      window.__mediaVisualizerAnimId = null;
    }
    const {
      stringEl6,
      stringEl5,
      stringEl4,
      stringEl3,
      stringEl2,
      stringEl1,
      rosetteGlow,
      wave1,
      wave2,
    } = getAudioElements();

    [stringEl6, stringEl5, stringEl4, stringEl3, stringEl2, stringEl1].forEach(
      (str) => {
        if (str) {
          str.style.transform = "scaleX(1)";
          str.style.filter = "none";
        }
      },
    );
    if (rosetteGlow) {
      rosetteGlow.style.transform = "scale(1)";
      rosetteGlow.style.opacity = "0";
    }
    if (wave1) {
      wave1.style.transform = "scale(1)";
      wave1.style.borderColor = "transparent";
    }
    if (wave2) {
      wave2.style.transform = "scale(1)";
      wave2.style.borderColor = "transparent";
    }

    const headerBars = document.querySelectorAll("#header-eq-bars .eq-bar");
    if (headerBars.length === 3) {
      (headerBars[0] as HTMLElement).style.transform = "scaleY(1)";
      (headerBars[1] as HTMLElement).style.transform = "scaleY(1)";
      (headerBars[2] as HTMLElement).style.transform = "scaleY(1)";
    }
    const heroBars = document.querySelectorAll("#hero-eq-bars .eq-hero-bar");
    if (heroBars.length === 3) {
      (heroBars[0] as HTMLElement).style.transform = "scaleY(1)";
      (heroBars[1] as HTMLElement).style.transform = "scaleY(1)";
      (heroBars[2] as HTMLElement).style.transform = "scaleY(1)";
    }
  };

  const setActiveTrackVisuals = (isPlaying: boolean) => {
    const { trackButtons } = getAudioElements();
    trackButtons.forEach((b, i) => {
      const eq = b.querySelector(".wave-equalizer");
      const num = b.querySelector(".track-number");
      const isActive = i === currentIndex;
      b.classList.toggle("border-amber-400/40", isActive);
      b.classList.toggle("bg-[#201511]", isActive);
      b.classList.toggle("track-active-glow", isActive && isPlaying);
      b.setAttribute("aria-current", isActive ? "true" : "false");
      if (isActive) {
        eq?.classList.remove("hidden");
        eq?.classList.add("flex");
        eq?.classList.toggle("is-animating", isPlaying);
        num?.classList.add("hidden");
      } else {
        eq?.classList.add("hidden");
        eq?.classList.remove("flex");
        eq?.classList.remove("is-animating");
        num?.classList.remove("hidden");
      }
    });
  };

  const updateUI = (isPlaying: boolean) => {
    const { playIcon, pauseIcon, guitarStrings, playingDot } =
      getAudioElements();
    if (isPlaying) {
      playIcon?.classList.add("hidden");
      pauseIcon?.classList.remove("hidden");
      guitarStrings?.classList.replace("opacity-50", "opacity-85");
      playingDot?.classList.replace("bg-amber-500/40", "bg-amber-400");
      playingDot?.classList.add("animate-pulse");
      startVisualizer();
    } else {
      playIcon?.classList.remove("hidden");
      pauseIcon?.classList.add("hidden");
      guitarStrings?.classList.replace("opacity-85", "opacity-50");
      playingDot?.classList.replace("bg-amber-400", "bg-amber-500/40");
      playingDot?.classList.remove("animate-pulse");
      stopVisualizer();
    }
    setActiveTrackVisuals(isPlaying);
  };

  const syncTrackMetadataUI = () => {
    const {
      trackButtons,
      titleDisplay,
      genreDisplay,
      descDisplay,
      totalDurationDisplay,
    } = getAudioElements();
    const btn = trackButtons[currentIndex];
    if (!btn) return;

    const title = btn.getAttribute("data-title") || "";
    const genre = btn.getAttribute("data-genre") || "";
    const desc = btn.getAttribute("data-desc") || "";
    const duration = btn.getAttribute("data-duration") || "0:00";

    if (titleDisplay) titleDisplay.textContent = title;
    if (genreDisplay && genre) genreDisplay.textContent = genre;
    if (descDisplay && desc) descDisplay.textContent = desc;
    if (totalDurationDisplay) totalDurationDisplay.textContent = duration;
  };

  const loadAndPlayTrack = (index: number) => {
    currentIndex = index;
    if (window.__playTrackByIndex) {
      window.__playTrackByIndex(index);
    } else {
      const { player, trackButtons } = getAudioElements();
      const btn = trackButtons[index];
      const src = btn?.getAttribute("data-src");
      if (player && src) {
        player.src = src;
        player.load();
        player.play().catch(() => {});
      }
    }
    syncTrackMetadataUI();
    updateUI(true);
  };

  const togglePlayPause = () => {
    vibrateMobile();
    if (window.__toggleGlobalPlay) {
      window.__toggleGlobalPlay();
    } else {
      const { player } = getAudioElements();
      if (player) {
        if (player.paused) {
          player.play().catch(() => {});
        } else {
          player.pause();
        }
      }
    }
  };

  const initMediaShowcase = () => {
    const elems = getAudioElements();
    if (!elems.player || !elems.playBtn) return;

    if (typeof window.__audioState?.currentIndex === "number") {
      currentIndex = window.__audioState.currentIndex;
    }

    const isPlaying = !elems.player.paused;

    syncTrackMetadataUI();
    updateUI(isPlaying);

    if (elems.player.duration) {
      const progressPercent =
        (elems.player.currentTime / elems.player.duration) * 100;
      if (elems.progressBar)
        (elems.progressBar as HTMLElement).style.width = `${progressPercent}%`;
      elems.progressContainer?.setAttribute(
        "aria-valuenow",
        String(Math.round(progressPercent)),
      );
      const mins = Math.floor(elems.player.currentTime / 60);
      const secs = Math.floor(elems.player.currentTime % 60);
      if (elems.currentTimeDisplay) {
        elems.currentTimeDisplay.textContent = `${mins}:${secs.toString().padStart(2, "0")}`;
      }
    }

    if (
      !elems.player.src ||
      elems.player.src === window.location.href ||
      elems.player.src.endsWith("/")
    ) {
      const firstSrc = elems.trackButtons[0]?.getAttribute("data-src");
      if (firstSrc) {
        elems.player.src = firstSrc;
      }
    }

    elems.player.volume = lastVolume;
    if (elems.volumeSlider) {
      elems.volumeSlider.value = String(Math.round(lastVolume * 100));
    }

    elems.playBtn.addEventListener("click", togglePlayPause);

    elems.prevBtn?.addEventListener("click", () => {
      vibrateMobile();
      loadAndPlayTrack(
        (currentIndex - 1 + elems.trackButtons.length) %
          elems.trackButtons.length,
      );
    });

    elems.nextBtn?.addEventListener("click", () => {
      vibrateMobile();
      loadAndPlayTrack((currentIndex + 1) % elems.trackButtons.length);
    });

    elems.trackButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        vibrateMobile();
        const index = parseInt(btn.getAttribute("data-index") || "0", 10);
        if (index === currentIndex) {
          togglePlayPause();
        } else {
          loadAndPlayTrack(index);
        }
      });
    });

    elems.progressContainer?.addEventListener("click", (e: MouseEvent) => {
      if (
        !elems.player ||
        !elems.player.duration ||
        isNaN(elems.player.duration)
      )
        return;

      const container = elems.progressContainer as HTMLElement;
      const rect = container.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const ratio = Math.max(0, Math.min(1, clickX / rect.width));

      const ripple = document.createElement("span");
      ripple.className =
        "absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-white/80 rounded-full animate-ping pointer-events-none z-20";
      ripple.style.left = `${clickX - 6}px`;
      container.appendChild(ripple);

      setTimeout(() => ripple.remove(), 600);

      elems.player.currentTime = ratio * elems.player.duration;
    });

    elems.volumeSlider?.addEventListener("input", () => {
      if (!elems.player || !elems.volumeSlider) return;
      const val = parseInt(elems.volumeSlider.value, 10) / 100;
      elems.player.volume = val;
      lastVolume = val > 0 ? val : lastVolume;
      elems.volumeIcon?.classList.toggle("hidden", val === 0);
      elems.muteIcon?.classList.toggle("hidden", val > 0);
    });

    elems.muteBtn?.addEventListener("click", () => {
      if (!elems.player) return;
      vibrateMobile();
      if (elems.player.volume > 0) {
        elems.player.volume = 0;
        if (elems.volumeSlider) elems.volumeSlider.value = "0";
        elems.volumeIcon?.classList.add("hidden");
        elems.muteIcon?.classList.remove("hidden");
      } else {
        elems.player.volume = lastVolume;
        if (elems.volumeSlider)
          elems.volumeSlider.value = String(Math.round(lastVolume * 100));
        elems.volumeIcon?.classList.remove("hidden");
        elems.muteIcon?.classList.add("hidden");
      }
    });

    const openLightbox = (src: string, alt: string, caption: string) => {
      if (!elems.lightboxModal || !elems.lightboxImg) return;
      elems.lightboxImg.src = src;
      elems.lightboxImg.alt = alt;
      if (elems.lightboxCaption) {
        if (caption && caption.trim() !== "") {
          elems.lightboxCaption.textContent = caption;
          elems.lightboxCaption.classList.remove("hidden");
        } else {
          elems.lightboxCaption.textContent = "";
          elems.lightboxCaption.classList.add("hidden");
        }
      }
      elems.lightboxModal.classList.remove("hidden");
      elems.lightboxModal.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const closeLightbox = () => {
      if (!elems.lightboxModal) return;
      elems.lightboxModal.classList.add("hidden");
      elems.lightboxModal.classList.remove("flex");
      document.body.style.overflow = "";
    };

    elems.galleryItems.forEach((item) => {
      item.addEventListener("click", () => {
        vibrateMobile();
        const src = item.getAttribute("data-src") || "";
        const alt = item.getAttribute("data-alt") || "";
        const caption = item.getAttribute("data-caption") || "";
        openLightbox(src, alt, caption);
      });
    });

    elems.lightboxClose?.addEventListener("click", () => {
      vibrateMobile();
      closeLightbox();
    });

    elems.lightboxModal?.addEventListener("click", (e) => {
      if (e.target === elems.lightboxModal) closeLightbox();
    });
  };

  document.addEventListener("astro:page-load", initMediaShowcase);

  document.addEventListener("astro:before-swap", () => {
    stopVisualizer();
  });

  window.addEventListener("audio-state-change", (e: Event) => {
    const customEvent = e as CustomEvent<{
      isPlaying: boolean;
      index?: number;
    }>;
    const isPlaying = customEvent.detail?.isPlaying ?? false;
    if (typeof customEvent.detail?.index === "number") {
      currentIndex = customEvent.detail.index;
    } else if (typeof window.__audioState?.currentIndex === "number") {
      currentIndex = window.__audioState.currentIndex;
    }
    syncTrackMetadataUI();
    updateUI(isPlaying);
  });

  window.addEventListener("audio-track-change", (e: Event) => {
    const customEvent = e as CustomEvent<{ title: string; index?: number }>;
    if (typeof customEvent.detail?.index === "number") {
      currentIndex = customEvent.detail.index;
    } else if (typeof window.__audioState?.currentIndex === "number") {
      currentIndex = window.__audioState.currentIndex;
    }
    const { player } = getAudioElements();
    syncTrackMetadataUI();
    setActiveTrackVisuals(player ? !player.paused : false);
  });

  window.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.code === "Space") {
      const activeElement = document.activeElement;
      const isInputFocused =
        activeElement instanceof HTMLInputElement ||
        activeElement instanceof HTMLTextAreaElement ||
        activeElement?.getAttribute("contenteditable") === "true";

      if (!isInputFocused) {
        e.preventDefault();
        togglePlayPause();
      }
    }
  });

  window.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape") {
      const lightbox =
        document.getElementById("lightbox-modal") ||
        document.getElementById("gallery-modal");
      if (lightbox && !lightbox.classList.contains("hidden")) {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
      }
    }
  });

  const attachPlayerListeners = () => {
    const player = document.getElementById(
      "main-audio-player",
    ) as HTMLAudioElement | null;
    if (!player) return;

    player.addEventListener("timeupdate", () => {
      if (player.duration) {
        const { progressBar, progressContainer, currentTimeDisplay } =
          getAudioElements();
        const progressPercent = (player.currentTime / player.duration) * 100;
        if (progressBar)
          (progressBar as HTMLElement).style.width = `${progressPercent}%`;
        progressContainer?.setAttribute(
          "aria-valuenow",
          String(Math.round(progressPercent)),
        );
        const mins = Math.floor(player.currentTime / 60);
        const secs = Math.floor(player.currentTime % 60);
        if (currentTimeDisplay) {
          currentTimeDisplay.textContent = `${mins}:${secs.toString().padStart(2, "0")}`;
        }
      }
    });

    player.addEventListener("waiting", () => {
      const { loadingSpinner } = getAudioElements();
      loadingSpinner?.classList.remove("hidden");
      loadingSpinner?.classList.add("flex");
    });

    player.addEventListener("canplay", () => {
      const { loadingSpinner } = getAudioElements();
      loadingSpinner?.classList.add("hidden");
      loadingSpinner?.classList.remove("flex");
    });
  };

  attachPlayerListeners();
  document.addEventListener("astro:page-load", attachPlayerListeners);
</script>
