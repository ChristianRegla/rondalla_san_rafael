---
import { Play, Pause, SkipForward, SkipBack, Volume2, VolumeX, Music2, Sparkles, X, ZoomIn } from '@lucide/astro';
import { useTranslations } from '../i18n/ui';
import { REPERTOIRE_TRACKS } from '../config/repertoire';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const foto_album = '/images/foto_album.webp';
const tracks = REPERTOIRE_TRACKS;

const galleryImages = [
  { 
    alt: 'Rondalla San Rafael - Retrato Oficial de Gala', 
    src: '/images/foto_album.webp', 
    caption: lang === 'es' ? 'Presentación de gala formal: 12 músicos en smoking de etiqueta en Puerto Vallarta.' : 'Formal Gala Presentation: 12 musicians in tuxedo in Puerto Vallarta.',
    tag: lang === 'es' ? 'Gala de Etiqueta' : 'Formal Gala',
  },
  { 
    alt: 'Rondalla San Rafael en vivo en Puerto Vallarta', 
    src: '/images/galeria-1.webp', 
    caption: lang === 'es' ? 'Serenata acústica tradicional: guitarras, requintos y contrabajo de madera noble.' : 'Traditional acoustic serenade: guitars, requintos, and double bass.',
    tag: lang === 'es' ? 'Serenata en Vivo' : 'Live Serenade',
  },
  { 
    alt: 'Instrumentos de luthería y guitarras de concierto', 
    src: '/images/galeria-2.webp', 
    caption: lang === 'es' ? 'Nuestros instrumentos de concierto: maderas nobles de cedro, abeto y palisandro.' : 'Our concert instruments: noble cedar, spruce, and rosewood tonewoods.',
    tag: lang === 'es' ? 'Maderas Nobles' : 'Noble Tonewoods',
  },
];
---

<section id="media" class="py-28 bg-[#0b0807] border-t border-amber-950/20 relative overflow-hidden">
  {/* Auras de resonancia armónica en el fondo */}
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[450px] bg-amber-600/[0.07] blur-[150px] pointer-events-none rounded-full"></div>
  <div class="absolute bottom-10 left-10 w-96 h-96 bg-[#8a431d]/[0.08] blur-[130px] pointer-events-none rounded-full"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    {/* Encabezado Editorial */}
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-md shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-amber-400" />
        <span>{lang === 'es' ? 'Colección Acústica de Estudio' : 'Studio Acoustic Collection'}</span>
      </div>
      <h2 class="font-serif text-4xl sm:text-6xl font-extrabold text-stone-100 tracking-tight mb-5 leading-tight">
        {lang === 'es' ? 'Repertorio & Galería de Gala' : 'Repertoire & Gala Gallery'}
      </h2>
      <p class="text-stone-300 text-base sm:text-lg font-light leading-relaxed">
        {lang === 'es' 
          ? 'Grabaciones directas de estudio. Escucha la pureza de las cuerdas de nylon, los requintos y las armonías vocales de la Rondalla San Rafael.' 
          : 'Direct studio recordings. Listen to the warmth of nylon strings, intricate requintos, and signature vocal harmonies of Rondalla San Rafael.'}
      </p>
    </div>

    {/* Reproductor: La Cámara de Resonancia Acústica */}
    <div class="liquid-glass-card rounded-[32px] p-6 sm:p-10 mb-20 relative overflow-hidden">
      
      {/* Reflejo especular diagonal */}
      <div class="absolute -top-32 -left-32 w-80 h-80 bg-gradient-to-tr from-transparent via-white/[0.04] to-transparent rotate-45 pointer-events-none blur-md"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        {/* Lado Izquierdo: Boca de Guitarra, Roseta Artesanal & Cuerdas */}
        <div class="lg:col-span-5 flex flex-col items-center text-center">
          
          <div class="relative w-56 h-56 sm:w-68 sm:h-68 mb-6 flex items-center justify-center">
            
            {/* Ondas concéntricas de resonancia acústica al sonar */}
            <div id="acoustic-wave-1" class="absolute inset-0 rounded-full border border-amber-500/0 pointer-events-none transition-all duration-700"></div>
            <div id="acoustic-wave-2" class="absolute -inset-4 rounded-full border border-amber-400/0 pointer-events-none transition-all duration-1000"></div>
            <div id="rosette-glow" class="absolute -inset-2 rounded-full bg-amber-500/0 blur-2xl pointer-events-none transition-all duration-700"></div>

            {/* Roseta de Luthería (Taracea en madera de palisandro, abeto y nácar) */}
            <div id="rosette-disc" class="w-full h-full rounded-full p-3 relative flex items-center justify-center shadow-[0_20px_50px_rgba(0,0,0,0.85)] border border-amber-500/30 bg-gradient-to-br from-[#241713] via-[#140e0c] to-[#090605] transition-all duration-700">
              
              {/* Anillos concéntricos de taracea artesanal */}
              <div class="absolute inset-2 rounded-full border border-amber-500/40 pointer-events-none"></div>
              <div class="absolute inset-3.5 rounded-full border border-dashed border-amber-400/30 pointer-events-none"></div>
              <div class="absolute inset-5 rounded-full border border-amber-600/25 pointer-events-none"></div>
              <div class="absolute inset-7 rounded-full border border-stone-800/90 pointer-events-none"></div>

              {/* Boca de la guitarra (Soundhole acústico profundo) */}
              <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full bg-gradient-to-b from-[#060403] via-[#0b0807] to-[#040302] border-2 border-amber-500/30 flex items-center justify-center relative shadow-[inset_0_12px_32px_rgba(0,0,0,0.95)] overflow-hidden">
                
                {/* 6 Cuerdas Acústicas (3 de fósforo bronce entorchadas, 3 de nylon translúcido) */}
                <div id="guitar-strings" class="absolute inset-x-0 h-full flex justify-center items-stretch gap-3 sm:gap-4 pointer-events-none opacity-40 z-10 transition-opacity">
                  {/* 6a cuerda: Mi grave (Bordón bronce grueso) */}
                  <span class="string-line w-[2.2px] bg-gradient-to-b from-amber-700 via-amber-400 to-amber-700"></span>
                  {/* 5a cuerda: La (Bordón bronce medio) */}
                  <span class="string-line w-[1.8px] bg-gradient-to-b from-amber-600 via-amber-300 to-amber-600"></span>
                  {/* 4a cuerda: Re (Bordón bronce fino) */}
                  <span class="string-line w-[1.4px] bg-gradient-to-b from-amber-500 via-amber-200 to-amber-500"></span>
                  {/* 3a cuerda: Sol (Nylon cristal) */}
                  <span class="string-line w-[1.2px] bg-gradient-to-b from-stone-400 via-white/80 to-stone-400"></span>
                  {/* 2a cuerda: Si (Nylon cristal) */}
                  <span class="string-line w-[1px] bg-gradient-to-b from-stone-400 via-white/90 to-stone-400"></span>
                  {/* 1a cuerda: Mi agudo (Nylon fino) */}
                  <span class="string-line w-[0.8px] bg-gradient-to-b from-stone-300 via-white to-stone-300"></span>
                </div>

                {/* Medallón Central: Retrato Oficial de Etiqueta */}
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-2 border-amber-400/40 flex items-center justify-center relative z-20 shadow-2xl overflow-hidden group">
                  <img 
                    src={foto_album} 
                    alt="Rondalla San Rafael de Puerto Vallarta" 
                    class="w-full h-full object-cover filter brightness-95 group-hover:scale-105 transition-transform duration-700"
                  />
                  {/* Bisel de cristal protector abombado */}
                  <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-transparent via-white/15 to-transparent pointer-events-none"></div>
                  <div class="absolute inset-0 rounded-full border border-amber-300/30 pointer-events-none"></div>
                </div>

              </div>

            </div>

            {/* Spinner de carga / buffering */}
            <div id="loading-spinner" class="hidden absolute inset-0 rounded-full items-center justify-center pointer-events-none z-30">
              <div class="w-12 h-12 rounded-full border-2 border-amber-400/20 border-t-amber-400 animate-spin"></div>
            </div>

          </div>

          {/* Estado de Reproducción & Metadatos del Tema */}
          <div class="flex items-center gap-2 mb-2">
            <span id="playing-dot" class="w-2 h-2 rounded-full bg-amber-500/40 transition-colors"></span>
            <span id="current-track-genre" class="text-[11px] font-semibold text-amber-300/90 uppercase tracking-widest">
              {tracks[0].genre}
            </span>
          </div>

          <h3 id="current-track-title" class="font-serif text-2xl sm:text-3xl font-extrabold text-stone-100 mb-1 max-w-full truncate px-2">
            {tracks[0].title}
          </h3>

          <p id="current-track-desc" class="text-xs text-stone-400 font-light max-w-xs mx-auto mb-6 leading-relaxed line-clamp-2">
            {tracks[0].description?.[lang] || 'Rondalla San Rafael de Puerto Vallarta'}
          </p>

          {/* Audio HTML Nativo */}
          <audio id="main-audio-player" class="hidden" preload="metadata">
            <source id="audio-source" src={tracks[0].src} type="audio/webm" />
          </audio>

          {/* Controles de Reproducción Refinados */}
          <div class="w-full max-w-xs space-y-4">
            
            {/* Barra de Progreso de Cristal */}
            <div class="space-y-1.5">
              <div 
                id="progress-container" 
                class="w-full h-2 bg-[#090605] border border-stone-800/80 rounded-full cursor-pointer relative overflow-hidden group shadow-inner"
                role="slider"
                tabindex="0"
                aria-label={lang === 'es' ? 'Progreso de la canción' : 'Track progress'}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <div id="progress-bar" class="h-full bg-gradient-to-r from-amber-600 via-amber-500 to-amber-300 rounded-full w-0 transition-all duration-100 relative">
                  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2.5 h-2.5 bg-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-md"></div>
                </div>
              </div>
              
              <div class="flex justify-between text-[11px] font-mono text-stone-400">
                <span id="current-time">0:00</span>
                <span id="total-duration">{tracks[0].duration}</span>
              </div>
            </div>

            {/* Botones de Transporte */}
            <div class="flex items-center justify-center gap-5 pt-1">
              <button 
                id="prev-btn" 
                type="button" 
                aria-label={lang === 'es' ? 'Canción anterior' : 'Previous track'} 
                class="p-2.5 rounded-full text-stone-400 hover:text-amber-300 hover:bg-white/5 border border-transparent hover:border-white/10 transition-all"
              >
                <SkipBack class="w-5 h-5" />
              </button>
              
              <button 
                id="play-btn" 
                type="button" 
                aria-label={lang === 'es' ? 'Reproducir o pausar' : 'Play or pause'} 
                class="w-14 h-14 rounded-full bg-gradient-to-tr from-amber-600 via-amber-500 to-amber-400 hover:from-amber-500 hover:to-amber-300 text-stone-950 flex items-center justify-center shadow-lg shadow-amber-600/30 hover:scale-105 active:scale-95 transition-all border border-amber-300/40"
              >
                <Play id="play-icon" class="w-6 h-6 fill-current ml-0.5" />
                <Pause id="pause-icon" class="w-6 h-6 fill-current hidden" />
              </button>
              
              <button 
                id="next-btn" 
                type="button" 
                aria-label={lang === 'es' ? 'Siguiente canción' : 'Next track'} 
                class="p-2.5 rounded-full text-stone-400 hover:text-amber-300 hover:bg-white/5 border border-transparent hover:border-white/10 transition-all"
              >
                <SkipForward class="w-5 h-5" />
              </button>
            </div>

            {/* Control de Volumen con Ícono Táctil */}
            <div class="flex items-center gap-2.5 pt-1">
              <button id="mute-btn" type="button" aria-label={lang === 'es' ? 'Silenciar' : 'Mute'} class="text-stone-400 hover:text-amber-300 transition-colors flex-shrink-0">
                <Volume2 id="volume-icon" class="w-4 h-4" />
                <VolumeX id="mute-icon" class="w-4 h-4 hidden" />
              </button>
              <input
                id="volume-slider"
                type="range"
                min="0"
                max="100"
                value="80"
                aria-label={lang === 'es' ? 'Volumen' : 'Volume'}
                class="volume-range w-full h-1.5 rounded-full appearance-none bg-stone-900 cursor-pointer border border-stone-800/80"
              />
            </div>

          </div>

        </div>

        {/* Lado Derecho: Lista de Reproducción de Estudio */}
        <div class="lg:col-span-7 flex flex-col h-full justify-between border-t lg:border-t-0 lg:border-l border-stone-800/70 pt-8 lg:pt-0 lg:pl-10">
          
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-stone-800/70">
            <h4 class="font-serif text-xl font-bold text-stone-100 flex items-center gap-2.5">
              <Music2 class="w-4.5 h-4.5 text-amber-400" />
              <span>{lang === 'es' ? 'Repertorio Seleccionado' : 'Selected Repertoire'}</span>
            </h4>
            <span class="text-xs text-amber-300/80 font-mono tracking-wider bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20">
              14 {lang === 'es' ? 'obras de concierto' : 'concert tracks'}
            </span>
          </div>

          {/* Lista con Scroll */}
          <div class="space-y-2 max-h-[380px] overflow-y-auto pr-2 custom-scrollbar">
            {tracks.map((track, idx) => (
              <button
                type="button"
                data-index={idx}
                data-src={track.src}
                data-title={track.title}
                data-genre={track.genre}
                data-duration={track.duration}
                data-desc={track.description?.[lang] || ''}
                aria-current={idx === 0 ? 'true' : 'false'}
                class="track-btn w-full flex items-center justify-between p-3.5 rounded-2xl bg-[#140e0c]/60 border border-stone-800/60 hover:border-amber-500/40 hover:bg-[#1f1511] transition-all text-left group relative overflow-hidden backdrop-blur-sm"
              >
                <div class="flex items-center gap-3.5 relative z-10 min-w-0 pr-3">
                  <span class="track-number w-6 text-xs font-mono font-semibold text-stone-400 group-hover:text-amber-400 transition-colors shrink-0">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  
                  <div class="truncate">
                    <span class="track-name font-serif text-base font-bold text-stone-200 group-hover:text-amber-300 transition-colors block truncate">
                      {track.title}
                    </span>
                    <span class="text-[11px] text-stone-400 font-light block truncate">
                      {track.genre}
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-3 relative z-10 shrink-0">
                  {/* Ecualizador de ondas animado (solo visible en el track activo cuando suena) */}
                  <div class="wave-equalizer hidden items-end gap-1 h-3.5">
                    <span class="w-0.5 h-full bg-amber-400 rounded-full"></span>
                    <span class="w-0.5 h-full bg-amber-400 rounded-full"></span>
                    <span class="w-0.5 h-full bg-amber-400 rounded-full"></span>
                  </div>
                  
                  <span class="text-xs text-stone-400 font-mono group-hover:text-stone-300 transition-colors">
                    {track.duration}
                  </span>
                </div>
              </button>
            ))}
          </div>

          <p class="text-xs text-stone-400 mt-6 text-center lg:text-left leading-relaxed font-light">
            * {lang === 'es' 
                ? 'Grabaciones originales interpretadas con requintos solistas, guitarras y armonías vocales por Rondalla San Rafael.' 
                : 'Original recordings performed on concert guitars and signature multi-part vocal harmonies by Rondalla San Rafael.'}
          </p>
        </div>

      </div>

    </div>

    {/* Tríptico de Galería de Gala con Lightbox Editorial */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {galleryImages.map((img) => (
        <button
          type="button"
          class="gallery-item group relative aspect-[4/3] rounded-3xl bg-[#140e0c] border border-stone-800/80 overflow-hidden shadow-xl hover:border-amber-500/50 transition-all duration-500 text-left cursor-zoom-in w-full focus:outline-none"
          data-src={img.src}
          data-alt={img.alt}
          data-caption={img.caption || ''}
        >
          <img 
            src={img.src} 
            alt={img.alt} 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-[1.06] transition-transform duration-700 ease-out filter brightness-90 group-hover:brightness-100" 
          />

          {/* Badge de Categoría de Foto */}
          <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/60 border border-white/15 text-stone-200 text-xs font-semibold backdrop-blur-md">
            {img.tag}
          </div>

          {/* Botón de zoom flotante */}
          <div class="absolute top-4 right-4 p-2.5 rounded-full bg-stone-950/60 border border-white/15 text-stone-300 opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-md shadow-lg">
            <ZoomIn class="w-4 h-4 text-amber-400" />
          </div>

          {/* Gradiente y caption editorial */}
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/40 to-transparent group-hover:via-stone-950/50 transition-all duration-300 flex items-end p-6">
            <span class="font-serif text-stone-100 text-base font-bold transform translate-y-0 group-hover:-translate-y-0.5 transition-transform duration-300 drop-shadow-md leading-snug">
              {img.caption}
            </span>
          </div>
        </button>
      ))}
    </div>

  </div>
</section>

{/* Lightbox Modal para fotos */}
<div 
  id="lightbox-modal" 
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-xl flex-col items-center justify-center p-4 sm:p-8 transition-all duration-300"
>
  <button 
    id="lightbox-close" 
    type="button" 
    class="absolute top-6 right-6 p-3 rounded-full bg-stone-900/80 border border-stone-800 text-stone-300 hover:text-amber-400 hover:bg-stone-800 transition-all z-10"
    aria-label={lang === 'es' ? 'Cerrar imagen' : 'Close image'}
  >
    <X class="w-6 h-6" />
  </button>

  <div class="relative max-w-5xl w-full max-h-[85vh] flex flex-col items-center justify-center">
    <img 
      id="lightbox-img" 
      src="" 
      alt="" 
      class="max-w-full max-h-[75vh] object-contain rounded-2xl border border-stone-800/80 shadow-2xl"
    />
    <p 
      id="lightbox-caption" 
      class="mt-4 font-serif text-stone-200 text-lg font-medium text-center hidden max-w-2xl px-4"
    ></p>
  </div>
</div>

<style>
  /* Custom Scrollbar */
  .custom-scrollbar::-webkit-scrollbar {
    width: 5px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(22, 16, 13, 0.5);
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(212, 163, 89, 0.3);
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(212, 163, 89, 0.6);
  }

  /* Animaciones de Ecualizador */
  @keyframes wave {
    0%, 100% { height: 20%; }
    50% { height: 100%; }
  }
  .wave-equalizer span:nth-child(1) { animation: wave 0.8s infinite ease-in-out; animation-play-state: paused; }
  .wave-equalizer span:nth-child(2) { animation: wave 0.8s infinite ease-in-out 0.2s; animation-play-state: paused; }
  .wave-equalizer span:nth-child(3) { animation: wave 0.8s infinite ease-in-out 0.4s; animation-play-state: paused; }
  .wave-equalizer.is-animating span { animation-play-state: running; }

  /* Slider de volumen estilizado */
  .volume-range {
    accent-color: #d4a359;
  }
  .volume-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #d4a359;
    box-shadow: 0 0 8px rgba(212, 163, 89, 0.8);
    cursor: pointer;
  }
  .volume-range::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: none;
    border-radius: 50%;
    background: #d4a359;
    box-shadow: 0 0 8px rgba(212, 163, 89, 0.8);
    cursor: pointer;
  }

  /* Brillo del track activo mientras suena */
  .track-active-glow {
    border-color: rgba(212, 163, 89, 0.5) !important;
    background: #241814 !important;
    box-shadow: 0 0 20px -4px rgba(212, 163, 89, 0.25);
  }
</style>

<script>
  let currentIndex = 0;
  const trackButtons = document.querySelectorAll('.track-btn');
  const player = document.getElementById('main-audio-player') as HTMLAudioElement;
  const audioSource = document.getElementById('audio-source') as HTMLSourceElement;
  const titleDisplay = document.getElementById('current-track-title');
  const genreDisplay = document.getElementById('current-track-genre');
  const descDisplay = document.getElementById('current-track-desc');
  const totalDurationDisplay = document.getElementById('total-duration');
  const currentTimeDisplay = document.getElementById('current-time');
  const progressBar = document.getElementById('progress-bar');
  const progressContainer = document.getElementById('progress-container');
  const loadingSpinner = document.getElementById('loading-spinner');
  const playingDot = document.getElementById('playing-dot');

  const playBtn = document.getElementById('play-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');

  const muteBtn = document.getElementById('mute-btn');
  const volumeIcon = document.getElementById('volume-icon');
  const muteIcon = document.getElementById('mute-icon');
  const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
  
  const rosetteDisc = document.getElementById('rosette-disc');
  const rosetteGlow = document.getElementById('rosette-glow');
  const wave1 = document.getElementById('acoustic-wave-1');
  const wave2 = document.getElementById('acoustic-wave-2');
  const guitarStrings = document.getElementById('guitar-strings');

  let lastVolume = 0.8;
  if (player) player.volume = lastVolume;

  const setActiveTrackVisuals = (isPlaying: boolean) => {
    trackButtons.forEach((b, i) => {
      const eq = b.querySelector('.wave-equalizer');
      const num = b.querySelector('.track-number');
      const isActive = i === currentIndex;

      b.classList.toggle('border-amber-400/40', isActive);
      b.classList.toggle('bg-[#201511]', isActive);
      b.classList.toggle('track-active-glow', isActive && isPlaying);
      b.setAttribute('aria-current', isActive ? 'true' : 'false');

      if (isActive) {
        eq?.classList.remove('hidden');
        eq?.classList.add('flex');
        eq?.classList.toggle('is-animating', isPlaying);
        num?.classList.add('hidden');
      } else {
        eq?.classList.add('hidden');
        eq?.classList.remove('flex');
        eq?.classList.remove('is-animating');
        num?.classList.remove('hidden');
      }
    });
  };

  const updateUI = (isPlaying: boolean) => {
    if (isPlaying) {
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
      
      // Activar auras acústicas y vibración de cuerdas
      wave1?.classList.add('acoustic-pulse', 'border-amber-400/30');
      wave2?.classList.add('acoustic-pulse', 'border-amber-500/20');
      rosetteGlow?.classList.replace('bg-amber-500/0', 'bg-amber-500/20');
      guitarStrings?.classList.replace('opacity-40', 'opacity-80');
      guitarStrings?.querySelectorAll('.string-line').forEach(s => s.classList.add('string-vibrating'));
      
      playingDot?.classList.replace('bg-amber-500/40', 'bg-amber-400');
      playingDot?.classList.add('animate-pulse');
    } else {
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      
      // Detener auras
      wave1?.classList.remove('acoustic-pulse', 'border-amber-400/30');
      wave2?.classList.remove('acoustic-pulse', 'border-amber-500/20');
      rosetteGlow?.classList.replace('bg-amber-500/20', 'bg-amber-500/0');
      guitarStrings?.classList.replace('opacity-80', 'opacity-40');
      guitarStrings?.querySelectorAll('.string-line').forEach(s => s.classList.remove('string-vibrating'));
      
      playingDot?.classList.replace('bg-amber-400', 'bg-amber-500/40');
      playingDot?.classList.remove('animate-pulse');
    }

    setActiveTrackVisuals(isPlaying);

    // Notificar al Header para el ecualizador flotante
    window.dispatchEvent(new CustomEvent('audio-state-change', { detail: { isPlaying } }));
  };

  const loadTrack = (index: number) => {
    if (index < 0 || index >= trackButtons.length) return;
    currentIndex = index;
    const btn = trackButtons[currentIndex];
    const src = btn.getAttribute('data-src');
    const title = btn.getAttribute('data-title');
    const genre = btn.getAttribute('data-genre');
    const desc = btn.getAttribute('data-desc');
    const duration = btn.getAttribute('data-duration');

    if (src && player && audioSource && titleDisplay) {
      audioSource.src = src;
      titleDisplay.textContent = title || '';
      if (genreDisplay && genre) genreDisplay.textContent = genre;
      if (descDisplay && desc) descDisplay.textContent = desc;
      if (totalDurationDisplay) totalDurationDisplay.textContent = duration || '0:00';
      if (progressBar) (progressBar as HTMLElement).style.width = '0%';
      if (currentTimeDisplay) currentTimeDisplay.textContent = '0:00';
      player.load();
      setActiveTrackVisuals(false);
    }
  };

  const loadAndPlayTrack = (index: number) => {
    loadTrack(index);
    player.play().then(() => updateUI(true)).catch(() => updateUI(false));
  };

  playBtn?.addEventListener('click', () => {
    if (player.paused) {
      player.play().then(() => updateUI(true)).catch(() => updateUI(false));
    } else {
      player.pause();
      updateUI(false);
    }
  });

  // Escuchar trigger de reproducción remota desde el botón Sound First del Hero
  window.addEventListener('trigger-audio-play', () => {
    if (player.paused) {
      player.play().then(() => updateUI(true)).catch(() => updateUI(false));
    } else {
      player.pause();
      updateUI(false);
    }
  });


  prevBtn?.addEventListener('click', () => loadAndPlayTrack((currentIndex - 1 + trackButtons.length) % trackButtons.length));
  nextBtn?.addEventListener('click', () => loadAndPlayTrack((currentIndex + 1) % trackButtons.length));

  trackButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = parseInt(btn.getAttribute('data-index') || '0', 10);
      if (index === currentIndex) {
        if (player.paused) {
          player.play().then(() => updateUI(true)).catch(() => updateUI(false));
        } else {
          player.pause();
          updateUI(false);
        }
      } else {
        loadAndPlayTrack(index);
      }
    });
  });

  // Progreso de Audio
  player?.addEventListener('timeupdate', () => {
    if (player.duration) {
      const progressPercent = (player.currentTime / player.duration) * 100;
      if (progressBar) (progressBar as HTMLElement).style.width = `${progressPercent}%`;
      progressContainer?.setAttribute('aria-valuenow', String(Math.round(progressPercent)));

      const mins = Math.floor(player.currentTime / 60);
      const secs = Math.floor(player.currentTime % 60);
      if (currentTimeDisplay) currentTimeDisplay.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
    }
  });

  const seekToRatio = (ratio: number) => {
    if (!player.duration || isNaN(player.duration)) return;
    player.currentTime = Math.max(0, Math.min(1, ratio)) * player.duration;
  };

  progressContainer?.addEventListener('click', (e: MouseEvent) => {
    const rect = (progressContainer as HTMLElement).getBoundingClientRect();
    seekToRatio((e.clientX - rect.left) / rect.width);
  });

  progressContainer?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!player.duration) return;
    const step = 5;
    if (e.key === 'ArrowRight') player.currentTime = Math.min(player.duration, player.currentTime + step);
    if (e.key === 'ArrowLeft') player.currentTime = Math.max(0, player.currentTime - step);
  });

  // Buffering
  player?.addEventListener('waiting', () => {
    loadingSpinner?.classList.remove('hidden');
    loadingSpinner?.classList.add('flex');
  });
  player?.addEventListener('canplay', () => {
    loadingSpinner?.classList.add('hidden');
    loadingSpinner?.classList.remove('flex');
  });

  // Siguiente pista al terminar
  player?.addEventListener('ended', () => {
    loadAndPlayTrack((currentIndex + 1) % trackButtons.length);
  });

  // Control de Volumen
  volumeSlider?.addEventListener('input', () => {
    const val = parseInt(volumeSlider.value, 10) / 100;
    player.volume = val;
    lastVolume = val > 0 ? val : lastVolume;
    volumeIcon?.classList.toggle('hidden', val === 0);
    muteIcon?.classList.toggle('hidden', val > 0);
  });

  muteBtn?.addEventListener('click', () => {
    if (player.volume > 0) {
      player.volume = 0;
      if (volumeSlider) volumeSlider.value = '0';
      volumeIcon?.classList.add('hidden');
      muteIcon?.classList.remove('hidden');
    } else {
      player.volume = lastVolume;
      if (volumeSlider) volumeSlider.value = String(Math.round(lastVolume * 100));
      volumeIcon?.classList.remove('hidden');
      muteIcon?.classList.add('hidden');
    }
  });

  // Inicializar pista 0
  loadTrack(0);

  // Lightbox
  const lightboxModal = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');
  const galleryItems = document.querySelectorAll('.gallery-item');

  const openLightbox = (src: string, alt: string, caption: string) => {
    if (!lightboxModal || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt;

    if (lightboxCaption) {
      if (caption && caption.trim() !== '') {
        lightboxCaption.textContent = caption;
        lightboxCaption.classList.remove('hidden');
      } else {
        lightboxCaption.textContent = '';
        lightboxCaption.classList.add('hidden');
      }
    }

    lightboxModal.classList.remove('hidden');
    lightboxModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightboxModal) return;
    lightboxModal.classList.add('hidden');
    lightboxModal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src') || '';
      const alt = item.getAttribute('data-alt') || '';
      const caption = item.getAttribute('data-caption') || '';
      openLightbox(src, alt, caption);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxModal?.addEventListener('click', (e) => {
    if (e.target === lightboxModal) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightboxModal && !lightboxModal.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>