---
import {
  Globe,
  Menu,
  X,
  Music,
  Play,
  Pause,
  SkipBack,
  SkipForward,
  ArrowUpRight,
} from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { SITE_CONFIG } from "../config/site";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const otherLang = lang === "es" ? "en" : "es";
const targetPath = lang === "es" ? "/en/" : "/";
const homePath = lang === "es" ? "/" : "/en/";

const navItems = [
  {
    href: `/${lang}/#nosotros`,
    label: t("nav.about"),
    external: false,
    sectionId: "nosotros",
  },
  {
    href: `/${lang}/#servicios`,
    label: t("nav.services"),
    external: false,
    sectionId: "servicios",
  },
  {
    href: `/${lang}/#media`,
    label: t("nav.media"),
    external: false,
    sectionId: "media",
  },
  {
    href: `/${lang}/#contacto`,
    label: t("nav.contact"),
    external: false,
    sectionId: "contacto",
  },
  {
    href: `/${lang}/galeria`,
    label: t("nav.gallery"),
    external: true,
    sectionId: "",
  },
  {
    href: `/${lang}/novedades`,
    label: t("nav.news"),
    external: true,
    sectionId: "",
  },
];
---

{/* Backdrop oscuro */}
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-black/0 backdrop-blur-0 z-40 opacity-0 pointer-events-none transition-all duration-300 lg:hidden transform-gpu"
>
</div>

{/* Header Flotante */}
<div
  class="fixed top-0 left-0 right-0 z-50 pt-4 pb-2 px-4 sm:px-6 pointer-events-none"
>
  <div
    class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-[#0e0c0b] via-[#0e0c0b]/80 to-transparent pointer-events-none -z-10"
  >
  </div>
  <header class="max-w-5xl mx-auto pointer-events-auto relative">
    {/* Cápsula de Cristal */}
    <div
      class="liquid-glass-container relative rounded-full p-[1px] transition-all duration-500"
    >
      <div
        class="absolute inset-0 rounded-full bg-gradient-to-b from-white/30 via-stone-500/10 to-amber-500/20 pointer-events-none"
      >
      </div>
      <div
        id="header-bar"
        class="liquid-glass-body relative rounded-full px-4 sm:px-7 h-14 sm:h-16 flex items-center justify-between overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.6)]"
      >
        <div
          class="absolute -top-24 -left-20 w-60 h-60 bg-gradient-to-tr from-transparent via-white/10 to-transparent rotate-45 pointer-events-none blur-sm"
        >
        </div>

        {/* Lado Izquierdo: Marca / Mini Player */}
        <div class="flex items-center min-w-0 mr-2 shrink-0">
          {/* ESTADO POR DEFECTO: MARCA */}
          <div
            id="default-header-content"
            class="flex items-center gap-2.5 min-w-0 transition-all duration-300 opacity-100 translate-y-0"
          >
            <div
              id="header-audio-badge"
              class="relative w-8 h-8 rounded-full bg-gradient-to-br from-amber-400/20 to-amber-600/10 border border-amber-400/40 flex items-center justify-center text-amber-300 hover:scale-105 transition-all duration-300 shadow-[0_0_15px_rgba(245,158,11,0.2)] cursor-pointer shrink-0"
              title={lang === "es" ? "Ir al reproductor" : "Go to player"}
            >
              <Music
                id="header-music-icon"
                class="w-4 h-4 transition-opacity duration-300"
              />
              <div
                id="header-eq-bars"
                class="absolute inset-0 flex items-center justify-center gap-[2px] opacity-0 transition-opacity duration-300"
              >
                <span
                  class="eq-bar w-[2px] h-3 bg-amber-400 rounded-full origin-bottom"
                  style="will-change: transform; transform-origin: bottom;"
                ></span>
                <span
                  class="eq-bar w-[2px] h-3.5 bg-amber-400 rounded-full origin-bottom"
                  style="will-change: transform; transform-origin: bottom;"
                ></span>
                <span
                  class="eq-bar w-[2px] h-2.5 bg-amber-400 rounded-full origin-bottom"
                  style="will-change: transform; transform-origin: bottom;"
                ></span>
              </div>
            </div>

            <a
              id="header-brand-title"
              href={homePath}
              class="font-serif font-bold text-sm sm:text-base tracking-tight text-stone-100 hover:text-amber-300 transition-colors drop-shadow-sm truncate block"
            >
              {SITE_CONFIG.name}
            </a>
          </div>

          {/* ESTADO REPRODUCCIÓN: MINI PLAYER */}
          <div
            id="header-mini-controls"
            class="hidden items-center gap-2 min-w-0 max-w-[160px] sm:max-w-[220px] md:max-w-[280px] opacity-0 translate-y-2 transition-all duration-300"
          >
            <div class="flex items-center gap-0.5 shrink-0">
              <button
                id="mini-prev-btn"
                type="button"
                class="p-1 rounded-full text-stone-400 hover:text-amber-300 hover:bg-white/10 transition-colors"
                aria-label="Previous Track"
              >
                <SkipBack class="w-3.5 h-3.5" />
              </button>

              <button
                id="mini-play-btn"
                type="button"
                class="w-7 h-7 rounded-full bg-amber-500 hover:bg-amber-400 text-stone-950 flex items-center justify-center transition-transform active:scale-90 shadow-[0_0_10px_rgba(245,158,11,0.4)] shrink-0"
                aria-label="Play/Pause Mini Player"
              >
                <Play
                  id="mini-play-icon"
                  class="w-3.5 h-3.5 fill-current ml-0.5"
                />
                <Pause
                  id="mini-pause-icon"
                  class="w-3.5 h-3.5 fill-current hidden"
                />
              </button>

              <button
                id="mini-next-btn"
                type="button"
                class="p-1 rounded-full text-stone-400 hover:text-amber-300 hover:bg-white/10 transition-colors"
                aria-label="Next Track"
              >
                <SkipForward class="w-3.5 h-3.5" />
              </button>
            </div>

            <div
              id="mini-track-info"
              class="flex-1 min-w-0 overflow-hidden flex flex-col justify-center cursor-pointer"
              title={lang === "es"
                ? "Ir a la sección de música"
                : "Go to music section"}
            >
              <span
                id="mini-track-title"
                class="block font-serif font-bold text-xs sm:text-sm text-stone-100 truncate hover:text-amber-300 transition-colors w-full"
              >
                Cargando...
              </span>
              <span
                class="flex items-center gap-1 text-[9px] text-amber-400 font-mono tracking-wider uppercase leading-none truncate mt-0.5"
              >
                <span
                  class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse shrink-0"
                ></span>
                <span class="truncate"
                  >{lang === "es" ? "En vivo" : "Live"}</span
                >
              </span>
            </div>
          </div>
        </div>

        {/* Menú Desktop con Scrollspy */}
        <nav
          id="header-nav"
          class="hidden lg:flex items-center gap-1 xl:gap-1.5 ml-auto pr-2"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                data-nav-section={item.sectionId}
                class={`nav-link-item group text-xs font-medium transition-all py-1.5 px-3 rounded-full flex items-center gap-1 active:scale-95 ${
                  item.external
                    ? "text-amber-200/90 hover:text-amber-300 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-400/20"
                    : "text-stone-300 hover:text-white hover:bg-white/10"
                }`}
              >
                <span>{item.label}</span>
                {item.external && (
                  <ArrowUpRight class="w-3 h-3 text-amber-400/80 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
                )}
              </a>
            ))
          }
        </nav>

        {/* Lado Derecho */}
        <div
          class="flex items-center gap-2.5 sm:gap-3 shrink-0 relative z-20 pl-2 border-l border-white/5 lg:border-transparent ml-auto lg:ml-0"
        >
          <a
            href={targetPath}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/5 border border-white/15 text-[11px] font-semibold text-stone-200 hover:text-white hover:bg-white/15 hover:border-amber-400/50 transition-all shadow-inner"
            title={lang === "es" ? "Switch to English" : "Cambiar a Español"}
          >
            <Globe class="w-3.5 h-3.5 text-amber-400" />
            <span class="uppercase font-mono">{otherLang}</span>
          </a>
          <button
            id="menu-toggle"
            class="lg:hidden p-1.5 rounded-full text-stone-300 hover:text-white hover:bg-white/10 transition-colors relative z-50 cursor-pointer"
            aria-label="Toggle Menu"
          >
            <Menu id="icon-open" class="w-5 h-5 block" />
            <X id="icon-close" class="w-5 h-5 hidden" />
          </button>
        </div>
      </div>
    </div>

    {/* Pop-over Dropdown Móvil */}
    <div
      id="mobile-overlay"
      class="absolute top-full right-0 pt-2 opacity-0 pointer-events-none lg:hidden z-40 mobile-overlay-transition"
    >
      <div
        id="mobile-card"
        class="liquid-glass-body relative rounded-[28px] p-2 border border-white/15 shadow-[0_25px_60px_rgba(0,0,0,0.85)] overflow-hidden mobile-card-transition min-w-[220px]"
      >
        <div
          class="absolute -top-1.5 right-6 w-3 h-3 rotate-45 liquid-glass-body border-t border-l border-white/15"
        >
        </div>
        <div
          class="absolute inset-0 rounded-[28px] bg-gradient-to-b from-white/15 via-transparent to-amber-500/10 pointer-events-none"
        >
        </div>
        <div
          class="absolute top-0 left-4 right-4 h-px bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none"
        >
        </div>
        <nav class="flex flex-col relative z-10 gap-0.5">
          {
            navItems.map((item, i) => (
              <a
                href={item.href}
                data-nav-section={item.sectionId}
                class={`mobile-link nav-link-item group flex items-center justify-between text-sm font-medium px-4 py-3 rounded-2xl transition-all active:scale-[0.97] ${
                  item.external
                    ? "text-amber-300 hover:bg-amber-500/15 bg-amber-500/5"
                    : "text-stone-200 hover:text-amber-300 hover:bg-white/10"
                }`}
                style={`transition-delay: ${i * 30}ms`}
              >
                <span>{item.label}</span>
                {item.external ? (
                  <ArrowUpRight class="w-4 h-4 text-amber-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
                ) : (
                  <span class="w-1 h-1 rounded-full bg-amber-400/0 group-hover:bg-amber-400/80 transition-all scale-0 group-hover:scale-100" />
                )}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </header>
</div>

<style>
  .mobile-overlay-transition {
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-card-transition {
    transform-origin: top right;
    transform: translateY(-8px) scale(0.95);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  #mobile-overlay.is-open .mobile-card-transition {
    transform: translateY(0) scale(1);
  }
  .mobile-link {
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }
  #mobile-overlay.is-open .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }
  .liquid-glass-container {
    will-change: transform;
    transform: translateZ(0);
  }
  /* Estilo de Scrollspy Activo */
  .nav-active-section {
    color: #fcd34d !important;
    background-color: rgba(245, 158, 11, 0.15) !important;
  }
</style>

<script>
  const initHeader = () => {
    const toggleBtn = document.getElementById("menu-toggle");
    const overlay = document.getElementById("mobile-overlay");
    const backdrop = document.getElementById("mobile-backdrop");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-link");
    let isOpen = false;

    const vibrateMobile = () => {
      if ("vibrate" in navigator) {
        navigator.vibrate(15);
      }
    };

    const openMenu = () => {
      isOpen = true;
      overlay?.classList.remove("opacity-0", "pointer-events-none");
      overlay?.classList.add("opacity-100", "pointer-events-auto", "is-open");
      backdrop?.classList.remove(
        "opacity-0",
        "pointer-events-none",
        "bg-black/0",
      );
      backdrop?.classList.add(
        "opacity-100",
        "pointer-events-auto",
        "bg-black/40",
      );
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    };

    const closeMenu = () => {
      isOpen = false;
      overlay?.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "is-open",
      );
      overlay?.classList.add("opacity-0", "pointer-events-none");
      backdrop?.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "bg-black/40",
      );
      backdrop?.classList.add("opacity-0", "pointer-events-none", "bg-black/0");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    };

    toggleBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      vibrateMobile();
      isOpen ? closeMenu() : openMenu();
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) closeMenu();
      });
    });

    backdrop?.addEventListener("click", closeMenu);

    // --- SCROLLSPY ACTIVO ---
    const sections = document.querySelectorAll("section[id]");
    const navItemsEls = document.querySelectorAll(".nav-link-item");

    const observerOptions = {
      threshold: 0.3,
    };

    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navItemsEls.forEach((item) => {
            const targetSec = item.getAttribute("data-nav-section");
            if (targetSec === id) {
              item.classList.add("nav-active-section");
            } else if (targetSec !== "") {
              item.classList.remove("nav-active-section");
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((sec) => sectionObserver.observe(sec));

    // --- REPRODUCTOR & MINI CONTROLES ---
    const defaultHeaderContent = document.getElementById(
      "default-header-content",
    );
    const miniControls = document.getElementById("header-mini-controls");

    const headerBadge = document.getElementById("header-audio-badge");
    const musicIcon = document.getElementById("header-music-icon");
    const eqBars = document.getElementById("header-eq-bars");

    const miniPlayBtn = document.getElementById("mini-play-btn");
    const miniPlayIcon = document.getElementById("mini-play-icon");
    const miniPauseIcon = document.getElementById("mini-pause-icon");
    const miniPrevBtn = document.getElementById("mini-prev-btn");
    const miniNextBtn = document.getElementById("mini-next-btn");
    const miniTrackInfo = document.getElementById("mini-track-info");

    const miniTrackTitle = document.getElementById("mini-track-title");

    const player = document.getElementById(
      "main-audio-player",
    ) as HTMLAudioElement | null;
    let isAudioPlaying = player ? !player.paused : false;
    let isMediaInView = false;

    miniPlayBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      vibrateMobile();
      window.dispatchEvent(new CustomEvent("trigger-audio-play"));
    });

    miniPrevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      vibrateMobile();
      window.dispatchEvent(new CustomEvent("trigger-audio-prev"));
    });

    miniNextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      vibrateMobile();
      window.dispatchEvent(new CustomEvent("trigger-audio-next"));
    });

    const scrollToMediaSection = (e: Event) => {
      e.preventDefault();
      const mediaSection = document.getElementById("media");
      if (mediaSection) {
        mediaSection.scrollIntoView({ behavior: "smooth" });
      } else {
        const currentLang = document.documentElement.lang || "es";
        window.location.href = `/${currentLang}/#media`;
      }
    };

    headerBadge?.addEventListener("click", scrollToMediaSection);
    miniTrackInfo?.addEventListener("click", scrollToMediaSection);

    const mediaSection = document.getElementById("media");

    if (mediaSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isMediaInView = entry.isIntersecting;
            updateHeaderState();
          });
        },
        { threshold: 0.15 },
      );
      observer.observe(mediaSection);
    }

    const updateHeaderState = () => {
      // Si no existe la sección media en la página actual (ej. galería), mostrar el mini player siempre que esté sonando música
      const shouldShowMiniPlayer = isAudioPlaying && (!mediaSection || !isMediaInView);

      if (shouldShowMiniPlayer) {
        defaultHeaderContent?.classList.add("hidden");
        miniControls?.classList.remove("hidden", "opacity-0", "translate-y-2");
        miniControls?.classList.add("flex", "opacity-100", "translate-y-0");
      } else {
        miniControls?.classList.remove("flex", "opacity-100", "translate-y-0");
        miniControls?.classList.add("hidden", "opacity-0", "translate-y-2");
        defaultHeaderContent?.classList.remove("hidden");
      }
    };

    const syncHeaderAudioUI = (playing: boolean) => {
      if (!headerBadge || !musicIcon || !eqBars) return;

      if (playing) {
        musicIcon.classList.add("opacity-0");
        eqBars.classList.remove("opacity-0");
        headerBadge.classList.add(
          "is-playing",
          "border-amber-400",
          "shadow-[0_0_20px_rgba(245,158,11,0.5)]",
        );
        miniPlayIcon?.classList.add("hidden");
        miniPauseIcon?.classList.remove("hidden");
      } else {
        musicIcon.classList.remove("opacity-0");
        eqBars.classList.add("opacity-0");
        headerBadge.classList.remove(
          "is-playing",
          "border-amber-400",
          "shadow-[0_0_20px_rgba(245,158,11,0.5)]",
        );
        miniPlayIcon?.classList.remove("hidden");
        miniPauseIcon?.classList.add("hidden");
      }

      const activeTitle =
        window.__audioState?.title ||
        document.getElementById("current-track-title")?.textContent;

      if (activeTitle && miniTrackTitle) {
        miniTrackTitle.textContent = activeTitle;
      }

      updateHeaderState();
    };

    // Sincronizar estado inicial al entrar a la página
    syncHeaderAudioUI(isAudioPlaying);

    window.addEventListener("audio-state-change", (e: Event) => {
      const customEvent = e as CustomEvent<{ isPlaying: boolean }>;
      isAudioPlaying = customEvent.detail?.isPlaying ?? false;
      syncHeaderAudioUI(isAudioPlaying);
    });

    window.addEventListener("audio-track-change", (e: Event) => {
      const customEvent = e as CustomEvent<{ title: string }>;
      const newTitle = customEvent.detail?.title;
      if (newTitle && miniTrackTitle) {
        miniTrackTitle.textContent = newTitle;
      }
    });
  };

  // Inicializar al cargar o navegar en Astro SPA
  document.addEventListener("astro:page-load", initHeader);
</script>
