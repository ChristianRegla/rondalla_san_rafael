---
import { Users, HeartHandshake, Sparkles } from '@lucide/astro';
import { useTranslations } from '../i18n/ui';
import { SITE_CONFIG } from '../config/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  {
    value: '+10',
    label: lang === 'es' ? 'Años de trayectoria' : 'Years of experience',
  },
  {
    value: '+500',
    label: lang === 'es' ? 'Eventos amenizados' : 'Events performed',
  },
  {
    value: '100%',
    label: lang === 'es' ? 'Música en vivo' : 'Live acoustic music',
  },
];
---

<section id="nosotros" class="py-24 bg-[#0e0c0b] border-t border-amber-950/30 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Columna Izquierda: Texto e Historia */}
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider">
          <Sparkles class="w-3.5 h-3.5" />
          <span>{lang === 'es' ? 'Nuestra Historia' : 'Our Story'}</span>
        </div>

        <h2 class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-100 tracking-tight leading-tight">
          {lang === 'es' 
            ? 'Tradición, romanticismo y pasión por la música' 
            : 'Tradition, romance, and passion for music'}
        </h2>

        <p class="text-stone-300 text-base sm:text-lg leading-relaxed font-light">
          {lang === 'es' 
            ? 'Rondalla San Rafael nace con el propósito de preservar la calidez de las tradicionales serenatas y la elegancia de la música romántica en la costa del Pacífico mexicano.' 
            : 'Rondalla San Rafael was born to preserve the warmth of traditional serenades and the elegance of romantic music along the Mexican Pacific coast.'}
        </p>

        <p class="text-stone-400 text-sm sm:text-base leading-relaxed font-light">
          {lang === 'es' 
            ? 'Con armonías vocales, requintos y guitarras acústicas, acompañamos los momentos más especiales de nuestras familias y visitantes en Puerto Vallarta y la Riviera Nayarit.' 
            : 'Combining vocal harmonies, requintos, and acoustic guitars, we accompany the most cherished moments in Puerto Vallarta and Riviera Nayarit.'}
        </p>

        {/* Grid de Estadísticas */}
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-amber-950/40">
          {stats.map((stat) => (
            <div>
              <span class="block font-serif text-2xl sm:text-4xl font-bold text-amber-400 tracking-tight">
                {stat.value}
              </span>
              <span class="text-xs sm:text-sm text-stone-400 font-medium">
                {stat.label}
              </span>
            </div>
          ))}
        </div>
      </div>

      {/* Columna Derecha: Tarjeta Estilo Caoba */}
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl bg-[#140e0c] border border-stone-800/80 p-8 shadow-2xl overflow-hidden group">
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-amber-600/10 rounded-full blur-3xl group-hover:bg-amber-600/20 transition-all"></div>
          
          <div class="relative z-10 space-y-6">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shadow-inner">
              <Users class="w-6 h-6" />
            </div>

            <h3 class="font-serif text-xl font-bold text-stone-100">
              {lang === 'es' ? 'Música 100% Acústica y En Vivo' : '100% Live & Acoustic Music'}
            </h3>

            <p class="text-sm text-stone-400 leading-relaxed font-light">
              {lang === 'es'
                ? 'Adaptamos nuestra presentación al formato de tu evento, desde serenatas íntimas a la orilla del mar hasta grandes banquetes y reuniones familiares.'
                : 'We adapt our performance to your event format, from intimate beachfront serenades to grand banquets and family gatherings.'}
            </p>

            <div class="pt-4 border-t border-stone-800 flex items-center gap-3 text-xs text-stone-400">
              <HeartHandshake class="w-4 h-4 text-amber-500 shrink-0" />
              <span>{SITE_CONFIG.location}</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>