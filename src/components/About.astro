---
import { Sparkles, Music2, Heart, Award, MapPin } from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { SITE_CONFIG } from "../config/site";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pillars = [
  {
    icon: Music2,
    title: lang === "es" ? "Armonía a Tres Voces" : "Three-Part Vocal Harmony",
    description:
      lang === "es"
        ? "El entramado vocal clásico que distingue a la serenata mexicana: primera voz expresiva, segunda en terceras y bajo cantante."
        : "The signature Mexican serenade vocal tradition: expressive lead vocals, harmonizing seconds, and deep vocal foundation.",
  },
  {
    icon: Award,
    title:
      lang === "es" ? "100% Acústico & Sin Pistas" : "100% Acoustic & Live",
    description:
      lang === "es"
        ? "Maderas nobles de cedro, abeto y palisandro resonando en vivo. Sin sintetizadores ni grabaciones de apoyo; acústica pura."
        : "Noble cedar, spruce, and rosewood tonewoods resonating live. No synthesizers or backing tracks; pure acoustic music.",
  },
  {
    icon: Heart,
    title: lang === "es" ? "Herencia de la Bahía" : "Banderas Bay Heritage",
    description:
      lang === "es"
        ? "Más de una década acompañando pedidas de mano, aniversarios y veladas íntimas en Puerto Vallarta y Riviera Nayarit."
        : "Over a decade performing at beach proposals, weddings, and distinguished family celebrations along the Mexican Pacific.",
  },
];
---

<section
  id="nosotros"
  class="py-14 sm:py-20 bg-transparent relative overflow-hidden"
>
  <div
    class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-amber-400/20 to-transparent pointer-events-none"
  >
  </div>

  <div
    class="absolute inset-0 pointer-events-none overflow-hidden select-none"
    style="mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/4 -right-16 w-[500px] h-[500px] bg-gradient-to-bl from-amber-500/12 via-[#8a3a17]/10 to-transparent rounded-full blur-[130px]"
      style="transform: translateZ(0);"
    >
    </div>
    <div
      class="absolute top-1/2 -left-20 -translate-y-1/2 w-[420px] h-[420px] bg-amber-600/[0.06] rounded-full blur-[140px]"
      style="transform: translateZ(0);"
    >
    </div>

    <div class="absolute inset-0 opacity-[0.03]">
      <svg
        class="w-full h-full"
        viewBox="0 0 1200 800"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid slice"
      >
        <path
          d="M 600,200 L 350,750"
          stroke="#f2d49a"
          stroke-width="1.2"
          stroke-dasharray="6 4"></path>
        <path d="M 600,200 L 450,780" stroke="#f2d49a" stroke-width="1.2"
        ></path>
        <path d="M 600,200 L 530,790" stroke="#f2d49a" stroke-width="1.2"
        ></path>
        <path d="M 600,200 L 600,800" stroke="#f2d49a" stroke-width="1.5"
        ></path>
        <path d="M 600,200 L 670,790" stroke="#f2d49a" stroke-width="1.2"
        ></path>
        <path d="M 600,200 L 750,780" stroke="#f2d49a" stroke-width="1.2"
        ></path>
        <path
          d="M 600,200 L 850,750"
          stroke="#f2d49a"
          stroke-width="1.2"
          stroke-dasharray="6 4"></path>
        <path
          d="M 600,120 C 720,120 820,200 820,320 C 820,400 760,460 780,540 C 810,650 740,760 600,760 C 460,760 390,650 420,540 C 440,460 380,400 380,320 C 380,200 480,120 600,120 Z"
          stroke="#cf9a48"
          stroke-width="1.5"></path>
        <circle
          cx="600"
          cy="360"
          r="90"
          stroke="#cf9a48"
          stroke-width="1"
          stroke-dasharray="4 4"></circle>
        <circle cx="600" cy="360" r="110" stroke="#f2d49a" stroke-width="0.8"
        ></circle>
      </svg>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7 space-y-7">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-300 text-xs font-semibold uppercase tracking-widest backdrop-blur-md shadow-sm"
        >
          <Sparkles class="w-3.5 h-3.5 text-amber-400" />
          <span
            >{
              lang === "es"
                ? "Nuestra Historia & Herencia"
                : "Our Story & Heritage"
            }</span
          >
        </div>

        <h2
          class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-100 tracking-tight leading-[1.15]"
        >
          {
            lang === "es"
              ? "El arte de la serenata tradicional en la costa de Vallarta"
              : "The art of traditional live strings on the Mexican Pacific"
          }
        </h2>

        <p
          class="text-stone-300 text-base sm:text-lg leading-relaxed font-light"
        >
          {
            lang === "es"
              ? "Rondalla San Rafael nace para mantener vivo el romanticismo auténtico de las serenatas mexicanas. En una era dominada por sonidos digitales y bocinas sintéticas, nosotros honramos el sonido noble de las maderas y la calidez del canto a viva voz."
              : "Rondalla San Rafael was founded to keep alive the authentic romanticism of traditional Mexican serenades. In an era dominated by synthetic audio, we honor the noble acoustic sound of luthier tonewoods and heartfelt vocal harmony."
          }
        </p>

        <div class="space-y-4 pt-2 sm:pt-4">
          {
            pillars.map((pillar) => {
              const PillarIcon = pillar.icon;
              return (
                <div class="group p-4 sm:p-5 rounded-2xl liquid-glass-luthier border border-stone-800/80 hover:border-amber-400/40 transition-all duration-300 hover:translate-x-1.5 flex items-start gap-4 relative overflow-hidden shadow-lg hover:shadow-[0_16px_36px_-8px_rgba(0,0,0,0.7),0_0_24px_-4px_rgba(207,154,72,0.12)]">
                  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-300/30 to-transparent" />

                  <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/25 group-hover:border-amber-400/50 group-hover:bg-amber-500/20 flex items-center justify-center text-amber-400 shrink-0 shadow-inner transition-colors">
                    <PillarIcon class="w-5 h-5 transition-transform duration-300 group-hover:scale-110" />
                  </div>
                  <div>
                    <h3 class="font-serif text-base sm:text-lg font-bold text-stone-100 group-hover:text-amber-200 transition-colors mb-1">
                      {pillar.title}
                    </h3>
                    <p class="text-xs sm:text-sm text-stone-400 font-light leading-relaxed">
                      {pillar.description}
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>

      <div class="lg:col-span-5 flex justify-center w-full relative">
        <div
          class="absolute -inset-4 bg-gradient-to-tr from-amber-600/20 via-[#8a3a17]/25 to-transparent rounded-[36px] blur-2xl -z-10 pointer-events-none opacity-80"
        >
        </div>

        <div
          class="relative rounded-3xl overflow-hidden border border-amber-500/35 shadow-[0_25px_60px_rgba(0,0,0,0.9),0_0_40px_-10px_rgba(207,154,72,0.18)] group w-full max-w-md lg:max-w-none max-h-[480px] sm:max-h-[540px] aspect-[4/5]"
        >
          <div class="w-full h-full overflow-hidden bg-stone-950">
            <img
              src="/images/galeria-2.webp"
              alt="Guitarras de concierto de Rondalla San Rafael"
              class="w-full h-full object-cover object-center filter brightness-90 group-hover:scale-105 transition-transform duration-700 ease-out"
            />
          </div>

          <div
            class="absolute inset-0 bg-gradient-to-t from-[#0d0908] via-[#0d0908]/35 to-transparent flex flex-col justify-end p-5 sm:p-7"
          >
            <div
              class="liquid-glass-gold rounded-2xl p-4 sm:p-5 border border-amber-400/40 backdrop-blur-xl shadow-2xl relative overflow-hidden"
            >
              <div
                class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-200/50 to-transparent"
              >
              </div>
              <p
                class="font-serif italic text-xs sm:text-sm text-stone-200 leading-relaxed mb-3"
              >
                {
                  lang === "es"
                    ? '"Una serenata no es solo música que se escucha; es un instante de complicidad y cariño que se queda grabado en la memoria para siempre."'
                    : '"A serenade is not merely music to be heard; it is an intimate moment of devotion that remains etched in memory forever."'
                }
              </p>

              <div
                class="flex items-center justify-between pt-2.5 border-t border-amber-500/20 text-xs font-semibold text-amber-300"
              >
                <span class="truncate pr-2">Rondalla San Rafael</span>
                <span
                  class="flex items-center gap-1 font-mono text-[10px] sm:text-[11px] text-stone-400 shrink-0"
                >
                  <MapPin class="w-3 h-3 text-amber-400" />
                  {SITE_CONFIG.location}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
