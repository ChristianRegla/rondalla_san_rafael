---
import {
  Music,
  MapPin,
  Phone,
  Mail,
  ArrowUp,
  Video,
  Copy,
  Check,
} from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { SITE_CONFIG, getWhatsAppLink } from "../config/site";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const whatsappUrl = getWhatsAppLink(t("wa.message"));
const currentYear = new Date().getFullYear();

const navItems = [
  { href: `/${lang}/#hero`, label: t("nav.home") },
  { href: `/${lang}/#nosotros`, label: t("nav.about") },
  { href: `/${lang}/#servicios`, label: t("nav.services") },
  { href: `/${lang}/#media`, label: t("nav.media") },
  { href: `/${lang}/#testimonios`, label: t("nav.testimonials") },
  { href: `/${lang}/#faq`, label: t("nav.faq") },
  { href: `/${lang}/#contacto`, label: t("nav.contact") },
  { href: `/${lang}/galeria`, label: t("nav.gallery") },
  { href: `/${lang}/novedades`, label: t("nav.news") },
];
---

<footer
  id="contacto"
  class="bg-[#0b0807] border-t border-amber-950/30 pt-16 pb-12 relative"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div
      class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-stone-800/80"
    >
      {/* Columna 1: Marca */}
      <div class="md:col-span-2 space-y-4">
        <a href={`/${lang}/`} class="inline-flex items-center gap-2.5 group">
          <div
            class="w-9 h-9 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 group-hover:scale-105 transition-transform"
          >
            <Music class="w-4 h-4" />
          </div>
          <span
            class="font-serif font-bold text-xl text-stone-100 tracking-tight group-hover:text-amber-400 transition-colors"
          >
            {SITE_CONFIG.name}
          </span>
        </a>
        <p class="text-sm text-stone-400 max-w-sm leading-relaxed font-light">
          {
            lang === "es"
              ? "Agrupación musical romántica y tradicional dedicada a amenizar serenatas, bodas y eventos especiales en Puerto Vallarta y la Riviera Nayarit."
              : "Romantic and traditional musical ensemble dedicated to live music for serenades, weddings, and special events in Puerto Vallarta."
          }
        </p>
        {/* Redes Sociales */}
        <div class="flex items-center gap-3 pt-2">
          <a
            href={SITE_CONFIG.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-xl bg-[#140e0c] border border-stone-800 flex items-center justify-center text-stone-400 hover:text-amber-400 hover:border-amber-500/40 transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            href={SITE_CONFIG.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-xl bg-[#140e0c] border border-stone-800 flex items-center justify-center text-stone-400 hover:text-amber-400 hover:border-amber-500/40 transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path></svg
            >
          </a>
          <a
            href={SITE_CONFIG.socials.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-xl bg-[#140e0c] border border-stone-800 flex items-center justify-center text-stone-400 hover:text-amber-400 hover:border-amber-500/40 transition-colors"
            aria-label="YouTube"
          >
            <Video class="w-4 h-4" />
          </a>
        </div>
      </div>

      {/* Columna 2: Navegación */}
      <div>
        <h3
          class="font-serif text-sm font-semibold text-stone-100 uppercase tracking-wider mb-4"
        >
          {lang === "es" ? "Navegación" : "Navigation"}
        </h3>
        <ul class="space-y-2.5">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-stone-400 hover:text-amber-400 transition-colors font-light"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Columna 3: Contacto Directo */}
      <div>
        <h3
          class="font-serif text-sm font-semibold text-stone-100 uppercase tracking-wider mb-4"
        >
          {lang === "es" ? "Contacto" : "Contact"}
        </h3>
        <ul class="space-y-3 text-sm text-stone-400 font-light">
          <li class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
            <span>{SITE_CONFIG.location}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Phone class="w-4 h-4 text-emerald-400 shrink-0" />
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors"
            >
              WhatsApp / Llamadas
            </a>
          </li>
          {/* Botón de Copiar Correo */}
          <li class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-amber-500 shrink-0" />
            <div class="relative group inline-flex items-center gap-2">
              <button
                id="copy-email-btn"
                data-email={SITE_CONFIG.email}
                class="hover:text-stone-100 transition-colors flex items-center gap-1.5 focus:outline-none"
                title={lang === "es" ? "Copiar correo" : "Copy email"}
              >
                <span>{SITE_CONFIG.email}</span>
                <span
                  id="copy-icon-wrap"
                  class="p-1 rounded-md bg-stone-900 border border-stone-800 text-stone-400 group-hover:text-amber-400 group-hover:border-amber-500/30 transition-all"
                >
                  <Copy id="icon-copy" class="w-3 h-3" />
                  <Check
                    id="icon-check"
                    class="w-3 h-3 hidden text-emerald-400"
                  />
                </span>
              </button>
              {/* Tooltip flotante de confirmación */}
              <span
                id="copy-tooltip"
                class="absolute left-0 -top-8 px-2.5 py-1 rounded-lg bg-emerald-500 text-stone-950 font-semibold text-[10px] tracking-wide opacity-0 pointer-events-none transition-all duration-300 shadow-lg"
              >
                {lang === "es" ? "¡Copiado!" : "Copied!"}
              </span>
            </div>
          </li>
        </ul>
      </div>
    </div>

    {/* Créditos */}
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500 font-light"
    >
      <p>
        © {currentYear}
        {SITE_CONFIG.name}. {
          lang === "es"
            ? "Todos los derechos reservados."
            : "All rights reserved."
        }
      </p>
      <a
        href="#"
        class="inline-flex items-center gap-1.5 text-stone-400 hover:text-amber-400 transition-colors"
      >
        <span>{lang === "es" ? "Volver arriba" : "Back to top"}</span>
        <ArrowUp class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  const iconCopy = document.getElementById("icon-copy");
  const iconCheck = document.getElementById("icon-check");
  const tooltip = document.getElementById("copy-tooltip");

  copyBtn?.addEventListener("click", async () => {
    const email = copyBtn.getAttribute("data-email");
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      iconCopy?.classList.add("hidden");
      iconCheck?.classList.remove("hidden");
      tooltip?.classList.remove("opacity-0", "-top-8");
      tooltip?.classList.add("opacity-100", "-top-9");

      setTimeout(() => {
        iconCopy?.classList.remove("hidden");
        iconCheck?.classList.add("hidden");
        tooltip?.classList.remove("opacity-100", "-top-9");
        tooltip?.classList.add("opacity-0", "-top-8");
      }, 2000);
    } catch (err) {
      console.error("Error al copiar al portapapeles:", err);
    }
  });
</script>
