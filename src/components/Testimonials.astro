---
import { Heart, Sparkles, MapPin } from '@lucide/astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const testimonials = [
  {
    name: 'María Elena R.',
    location: 'Conchas Chinas, Puerto Vallarta',
    occasion: lang === 'es' ? '50 Aniversario de Bodas' : '50th Wedding Anniversary',
    comment: lang === 'es' 
      ? 'Puntualidad absoluta y una calidad vocal insuperable. Llegaron al atardecer frente al mar; el nudo en la garganta y las lágrimas de emoción de mis padres al escuchar "Gema" fue un regalo que jamás olvidaremos.' 
      : 'Absolute punctuality and breathtaking vocal harmony. They arrived at sunset overlooking the ocean; seeing my parents moved to tears as they played "Gema" was a gift we will cherish forever.',
    year: '2024',
  },
  {
    name: 'Carlos Mendoza',
    location: 'Marina Vallarta',
    occasion: lang === 'es' ? 'Serenata Sorpresa de Cumpleaños' : 'Birthday Surprise Serenade',
    comment: lang === 'es' 
      ? 'La coordinación por WhatsApp fue impecable. Llegaron en silencio, afinaron y entraron a media voz. Interpretaron todas las complacencias con una calidez humana que contagió a toda la familia.' 
      : 'Coordination via WhatsApp was seamless. They arrived quietly and entered with gentle acoustic warmth. They played every requested song with a heartfelt spirit that engaged the whole family.',
    year: '2024',
  },
  {
    name: 'Sarah & David M.',
    location: 'Playa Sayulita, Riviera Nayarit',
    occasion: lang === 'es' ? 'Pedida de Mano al Atardecer' : 'Sunset Marriage Proposal',
    comment: lang === 'es' 
      ? 'Organizar una pedida de mano a la distancia parecía difícil, pero la Rondalla San Rafael lo hizo mágico. Su música acústica bajo la brisa marina creó una atmósfera de película.' 
      : 'Planning a destination proposal from abroad felt daunting, but Rondalla San Rafael made it effortless and magical. Their live strings under the Pacific breeze felt like a movie scene.',
    year: '2023',
  },
];
---

<section id="testimonios" class="py-28 bg-[#0a0807] border-t border-amber-950/20 relative overflow-hidden">
  
  {/* Auras de Iluminación */}
  <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-amber-600/[0.05] rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    {/* Encabezado Editorial */}
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-md shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-amber-400" />
        <span>{lang === 'es' ? 'Libro de Recuerdos & Dedicatorias' : 'Guestbook & Memories'}</span>
      </div>
      <h2 class="font-serif text-4xl sm:text-6xl font-extrabold text-stone-100 tracking-tight mb-5 leading-tight">
        {lang === 'es' ? 'Ecos de Nuestras Serenatas' : 'Echoes of Our Serenades'}
      </h2>
      <p class="text-stone-300 text-base sm:text-lg font-light leading-relaxed">
        {lang === 'es' 
          ? 'Palabras de quienes nos han abierto las puertas de sus celebraciones más íntimas en la Bahía de Banderas.' 
          : 'Reflections from those who trusted our acoustic ensemble with their most cherished life milestones along Banderas Bay.'}
      </p>
    </div>

    {/* Tríptico de Dedicatorias en Cristal */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="liquid-glass-card rounded-[28px] p-8 sm:p-9 flex flex-col justify-between relative group hover:border-amber-500/40 transition-all duration-500 border border-stone-800/80 shadow-xl">
          
          {/* Marca de Agua Ornamental */}
          <div class="absolute top-6 right-6 text-amber-500/10 group-hover:text-amber-500/20 transition-colors pointer-events-none">
            <Heart class="w-8 h-8" />
          </div>

          <div class="space-y-5 relative z-10">
            {/* Ocasión & Etiqueta de Gala */}
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px] font-semibold tracking-wide">
              <span>{item.occasion}</span>
            </div>

            {/* Texto de la Dedicatoria en Serif Itálico */}
            <p class="font-serif italic text-base sm:text-lg text-stone-200 leading-relaxed font-normal">
              "{item.comment}"
            </p>
          </div>

          {/* Firma y Ubicación Real */}
          <div class="pt-6 border-t border-stone-800/70 mt-8 flex flex-col gap-1 text-xs">
            <div class="flex items-center justify-between">
              <span class="font-serif font-bold text-stone-100 text-base">
                {item.name}
              </span>
              <span class="font-mono text-[11px] text-stone-500">
                {item.year}
              </span>
            </div>
            
            <div class="flex items-center gap-1.5 text-stone-400 font-light">
              <MapPin class="w-3.5 h-3.5 text-amber-500 shrink-0" />
              <span>{item.location}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>