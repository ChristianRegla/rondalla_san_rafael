---
import { ChevronDown, MessageSquare } from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { getWhatsAppLink } from "../config/site";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const whatsappUrl = getWhatsAppLink(
  lang === "es"
    ? "Hola, tengo una duda específica para contratar a la Rondalla San Rafael."
    : "Hello, I have a specific question about booking Rondalla San Rafael.",
);

const faqs = [
  {
    question:
      lang === "es"
        ? "¿Con cuánta anticipación debo reservar una fecha?"
        : "How far in advance should I reserve our date?",
    answer:
      lang === "es"
        ? "Recomendamos agendar con al menos 1 a 2 semanas de anticipación para fechas comunes, y de 3 a 4 semanas para temporadas altas (Día de las Madres, San Valentín, diciembre) o fines de semana nupciales. Sin embargo, si tu serenata es urgente para hoy o mañana, consúltanos por WhatsApp para verificar disponibilidad inmediata de agenda."
        : "We recommend reserving at least 1 to 2 weeks ahead for standard dates, and 3 to 4 weeks ahead for peak seasons (Mother’s Day, Valentine’s, December) or wedding weekends. If you need a last-minute serenade for today or tomorrow, contact us via WhatsApp to check instant schedule availability.",
  },
  {
    question:
      lang === "es"
        ? "¿Qué zonas de Puerto Vallarta y Riviera Nayarit cubren?"
        : "Which areas of Puerto Vallarta and Riviera Nayarit do you cover?",
    answer:
      lang === "es"
        ? "Cubrimos todo el municipio de Puerto Vallarta (Zona Hotelera, Marina, Zona Romántica, Conchas Chinas, Mismaloya) y Riviera Nayarit (Nuevo Nayarit, Bucerías, La Cruz de Huanacaxtle, Sayulita y Punta de Mita). Para traslados fuera de la zona metropolitana se aplica una cuota mínima de viáticos previamente acordada."
        : "We cover all of Puerto Vallarta (Hotel Zone, Marina, Romantic Zone, Conchas Chinas, Mismaloya) and Riviera Nayarit (Nuevo Nayarit, Bucerias, La Cruz, Sayulita, and Punta de Mita). A minimal pre-agreed travel fee applies for locations beyond the main metropolitan area.",
  },
  {
    question:
      lang === "es"
        ? "¿Cómo se maneja la dinámica de la sorpresa en una serenata?"
        : "How is a surprise serenade coordinated?",
    answer:
      lang === "es"
        ? "Coordinamos minuciosamente el punto de encuentro y la hora exacta a través de WhatsApp. Llegamos de forma discreta, afinamos previamente y nos posicionamos para entrar tocando y cantando a media voz el tema elegido. Puedes indicarnos si deseas que entreguemos un ramo de rosas o un presente que nos proporciones al llegar."
        : "We coordinate the exact meeting point and timing via WhatsApp. We arrive discreetly, tune beforehand, and position ourselves to enter playing and harmonizing the chosen introductory ballad. We can also deliver flowers or gifts upon arrival.",
  },
  {
    question:
      lang === "es"
        ? "¿Puedo elegir las canciones del repertorio para mi evento?"
        : "Can I customize the setlist for my celebration?",
    answer:
      lang === "es"
        ? "¡Por supuesto! Puedes seleccionar tus piezas predilectas de nuestro repertorio de boleros tradicionales, baladas de rondalla y serenatas mexicanas. Si requieres una canción especial que no se encuentre en la lista habitual, la preparamos con anticipación para tu momento especial."
        : "Certainly! You can select your favorite pieces from our catalog of traditional boleros, Mexican serenades, and romantic ballads. If you request a song outside our standard setlist, we arrange it in advance for your event.",
  },
  {
    question:
      lang === "es"
        ? "¿Se requiere algún equipo de audio o amplificación en el lugar?"
        : "Is sound amplification equipment required on site?",
    answer:
      lang === "es"
        ? "En serenatas, playas íntimas y reuniones de sobremesa nos presentamos en formato 100% acústico natural (el volumen de los requintos, guitarras y el contrabajo es perfecto y envolvente). Para grandes banquetes, bodas en salones o eventos masivos, podemos coordinarnos con el equipo de sonido de tu banquetero o conectar nuestro propio sistema."
        : "For serenades, intimate beach proposals, and family dinners, we perform in pure 100% acoustic format (the resonance of the guitars, requintos, and upright bass is warm and naturally balanced). For large banquet halls or wedding receptions, we coordinate with the venue sound engineer or provide our sound equipment.",
  },
  {
    question:
      lang === "es"
        ? "¿Cómo se realiza el apartado y la liquidación del servicio?"
        : "How are the deposit and final payment handled?",
    answer:
      lang === "es"
        ? "Solicitamos un anticipo accesible para asegurar tu fecha y hora en el calendario oficial de la Rondalla. El saldo restante se liquida tranquilamente el día de la presentación (en efectivo o transferencia bancaria)."
        : "We request an initial deposit to secure your date and time on our calendar. The remaining balance is settled comfortably on the day of the performance (via cash or bank transfer).",
  },
];

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 bg-transparent relative overflow-hidden"
>
  {/* Transición fluida con puente de luz escénica */}
  <div class="relative w-full max-w-4xl mx-auto mb-14 pointer-events-none">
    <div class="h-px bg-gradient-to-r from-transparent via-amber-400/25 to-transparent"></div>
    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-64 h-4 bg-amber-500/15 blur-lg rounded-full"></div>
  </div>

  {/* ========================================================================
      ILUMINACIÓN ESCÉNICA: Resplandor Cálido de Taller & Foco Central
      ======================================================================== */}
  {/* Halo central cálido sobre el bloque de preguntas */}
  <div
    class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[600px] sm:w-[750px] h-[450px] pointer-events-none rounded-full"
    style="background: radial-gradient(circle at 50% 40%, rgba(228, 181, 98, 0.10) 0%, rgba(138, 58, 23, 0.06) 45%, transparent 75%); transform: translateX(-50%) translateZ(0);"
  >
  </div>
  {/* Uplight escénico inferior: resplandor esmeralda y ámbar que nace en la caja CTA */}
  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 w-[700px] sm:w-[850px] h-[320px] pointer-events-none"
    style="background: radial-gradient(ellipse 75% 45% at 50% 90%, rgba(13, 94, 66, 0.16) 0%, rgba(207, 154, 72, 0.08) 45%, transparent 80%); transform: translateX(-50%) translateZ(0);"
  >
  </div>
  {/* Reflector lateral izquierdo suave */}
  <div
    class="absolute top-1/2 -left-20 w-80 h-80 bg-[#8a431d]/[0.06] rounded-full blur-[130px] pointer-events-none"
    style="transform: translateZ(0);"
  >
  </div>

  {/* ========================================================================
      MICRO-PATRÓN VECTORIAL DE LUTHERÍA: Micro-Estructura de Cuerdas & Diapasón
      ======================================================================== */}
  <div
    class="absolute inset-0 pointer-events-none select-none overflow-hidden opacity-[0.03]"
    style="mask-image: radial-gradient(ellipse 70% 65% at 50% 45%, black 20%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 70% 65% at 50% 45%, black 20%, transparent 80%);"
    aria-hidden="true"
  >
    <svg
      class="w-full h-full"
      viewBox="0 0 1000 800"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      {/* Cuerdas longitudinales sutiles */}
      <line x1="250" y1="0" x2="250" y2="800" stroke="#f2d49a" stroke-width="0.8" />
      <line x1="350" y1="0" x2="350" y2="800" stroke="#f2d49a" stroke-width="1.0" />
      <line x1="450" y1="0" x2="450" y2="800" stroke="#cf9a48" stroke-width="1.2" />
      <line x1="550" y1="0" x2="550" y2="800" stroke="#cf9a48" stroke-width="1.2" />
      <line x1="650" y1="0" x2="650" y2="800" stroke="#8a5a1e" stroke-width="1.0" />
      <line x1="750" y1="0" x2="750" y2="800" stroke="#8a5a1e" stroke-width="0.8" />
      {/* Trastes acústicos horizontales */}
      <line x1="200" y1="120" x2="800" y2="120" stroke="#f2d49a" stroke-width="0.8" stroke-dasharray="10 8" />
      <line x1="200" y1="260" x2="800" y2="260" stroke="#cf9a48" stroke-width="1.0" stroke-dasharray="10 8" />
      <line x1="200" y1="420" x2="800" y2="420" stroke="#e4b562" stroke-width="1.2" />
      <line x1="200" y1="600" x2="800" y2="600" stroke="#cf9a48" stroke-width="1.0" stroke-dasharray="10 8" />
      {/* Puntos de nácar en el traste de octava */}
      <circle cx="500" cy="420" r="5" stroke="#f2d49a" stroke-width="1" fill="#f2d49a" />
    </svg>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
    {/* Encabezado */}
    <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-16">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-300 text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-md shadow-sm"
      >
        <MessageSquare class="w-3.5 h-3.5 text-amber-400" />
        <span
          >{
            lang === "es" ? "Dudas Frecuentes" : "Frequently Asked Questions"
          }</span
        >
      </div>
      <h2
        class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-100 tracking-tight mb-4"
      >
        {lang === "es" ? "Preguntas Frecuentes" : "Frequently Asked Questions"}
      </h2>
      <p class="text-stone-300 text-base sm:text-lg font-light leading-relaxed">
        {
          lang === "es"
            ? "Todo lo que necesitas saber para contratar a la Rondalla San Rafael en Puerto Vallarta."
            : "Everything you need to know when booking Rondalla San Rafael in Puerto Vallarta."
        }
      </p>
    </div>

    {/* Acordeones con Bisel Especular y Elevación */}
    <div class="space-y-4 mb-14">
      {
        faqs.map((faq) => (
          <details class="group liquid-glass-luthier rounded-2xl border border-stone-800/80 transition-all duration-300 hover:border-amber-400/35 relative overflow-hidden shadow-md [&[open]]:border-amber-400/50 [&[open]]:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.7),0_0_28px_-4px_rgba(207,154,72,0.16)]">
            {/* Bisel superior especular */}
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-300/30 to-transparent pointer-events-none"></div>

            <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer select-none text-left">
              <span class="font-serif text-base sm:text-lg font-bold text-stone-100 group-hover:text-amber-300 transition-colors pr-4">
                {faq.question}
              </span>
              <div class="w-8 h-8 rounded-full bg-stone-900/90 border border-stone-800 flex items-center justify-center text-stone-400 group-hover:text-amber-300 group-hover:border-amber-500/40 shrink-0 group-open:rotate-180 group-open:text-amber-300 group-open:border-amber-400/50 group-open:bg-amber-500/10 transition-all duration-300">
                <ChevronDown class="w-4 h-4" />
              </div>
            </summary>
            <div class="px-5 sm:px-6 pb-6 pt-1 text-sm sm:text-base text-stone-300 leading-relaxed border-t border-stone-800/50 mt-1 font-light">
              {faq.answer}
            </div>
          </details>
        ))
      }
    </div>

    {/* Caja CTA con Resplandor Joya Esmeralda & Luthería */}
    <div
      class="liquid-glass-card rounded-3xl p-6 sm:p-8 text-center flex flex-col sm:flex-row items-center justify-between gap-6 shadow-[0_25px_60px_-10px_rgba(0,0,0,0.9),0_0_35px_-8px_rgba(13,94,66,0.22)] border border-amber-500/30 relative overflow-hidden"
    >
      {/* Bisel superior especular */}
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-300/40 to-transparent pointer-events-none"></div>

      {/* Halo de luz interno sutil */}
      <div class="absolute -top-12 -left-12 w-40 h-40 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="text-center sm:text-left relative z-10">
        <h3 class="font-serif text-xl font-bold text-stone-100 mb-1">
          {
            lang === "es"
              ? "¿Tienes alguna duda en particular?"
              : "Do you have another question?"
          }
        </h3>
        <p class="text-xs sm:text-sm text-stone-300 font-light">
          {
            lang === "es"
              ? "Escríbenos directamente por WhatsApp y te asesoramos al instante para tu evento."
              : "Message us directly on WhatsApp and we will assist you immediately for your event."
          }
        </p>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 py-3.5 px-6 rounded-2xl liquid-glass-emerald text-stone-100 font-semibold text-sm transition-all hover:scale-[1.02] active:scale-[0.98] shrink-0 group relative z-10"
      >
        <MessageSquare
          class="w-4 h-4 text-emerald-300 group-hover:scale-110 transition-transform"
        />
        <span class="tracking-wide"
          >{lang === "es" ? "Preguntar por WhatsApp" : "Ask on WhatsApp"}</span
        >
      </a>
    </div>
  </div>
</section>
