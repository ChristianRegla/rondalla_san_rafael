---
import { ChevronDown, MessageSquare } from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { getWhatsAppLink } from "../config/site";
import { FAQS_DATA } from "../data/faqs";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const whatsappUrl = getWhatsAppLink(
  lang === "es"
    ? "Hola, tengo una duda específica para contratar a la Rondalla San Rafael."
    : "Hello, I have a specific question about booking Rondalla San Rafael.",
);

const faqs = FAQS_DATA.map((faq) => ({
  question: faq.question[lang],
  answer: faq.answer[lang],
}));

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 bg-transparent relative overflow-hidden"
>
  <div
    class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-amber-400/20 to-transparent pointer-events-none"
  >
  </div>

  <div
    class="absolute inset-0 pointer-events-none overflow-hidden select-none"
    style="mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[600px] sm:w-[750px] h-[450px] rounded-full"
      style="background: radial-gradient(circle at 50% 40%, rgba(228, 181, 98, 0.08) 0%, rgba(138, 58, 23, 0.04) 45%, transparent 75%); transform: translateX(-50%) translateZ(0);"
    >
    </div>
    <div
      class="absolute top-1/2 -left-20 w-80 h-80 bg-[#8a431d]/[0.05] rounded-full blur-[130px]"
      style="transform: translateZ(0);"
    >
    </div>

    <div class="absolute inset-0 opacity-[0.025]" aria-hidden="true">
      <svg
        class="w-full h-full"
        viewBox="0 0 1000 800"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
      >
        <line
          x1="250"
          y1="0"
          x2="250"
          y2="800"
          stroke="#f2d49a"
          stroke-width="0.8"></line>
        <line
          x1="350"
          y1="0"
          x2="350"
          y2="800"
          stroke="#f2d49a"
          stroke-width="1.0"></line>
        <line
          x1="450"
          y1="0"
          x2="450"
          y2="800"
          stroke="#cf9a48"
          stroke-width="1.2"></line>
        <line
          x1="550"
          y1="0"
          x2="550"
          y2="800"
          stroke="#cf9a48"
          stroke-width="1.2"></line>
        <line
          x1="650"
          y1="0"
          x2="650"
          y2="800"
          stroke="#8a5a1e"
          stroke-width="1.0"></line>
        <line
          x1="750"
          y1="0"
          x2="750"
          y2="800"
          stroke="#8a5a1e"
          stroke-width="0.8"></line>
        <line
          x1="200"
          y1="120"
          x2="800"
          y2="120"
          stroke="#f2d49a"
          stroke-width="0.8"
          stroke-dasharray="10 8"></line>
        <line
          x1="200"
          y1="260"
          x2="800"
          y2="260"
          stroke="#cf9a48"
          stroke-width="1.0"
          stroke-dasharray="10 8"></line>
        <line
          x1="200"
          y1="420"
          x2="800"
          y2="420"
          stroke="#e4b562"
          stroke-width="1.2"></line>
        <line
          x1="200"
          y1="600"
          x2="800"
          y2="600"
          stroke="#cf9a48"
          stroke-width="1.0"
          stroke-dasharray="10 8"></line>
        <circle
          cx="500"
          cy="420"
          r="5"
          stroke="#f2d49a"
          stroke-width="1"
          fill="#f2d49a"></circle>
      </svg>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-16">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-300 text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-md shadow-sm"
      >
        <MessageSquare class="w-3.5 h-3.5 text-amber-400" />
        <span>
          {lang === "es" ? "Dudas Frecuentes" : "Frequently Asked Questions"}
        </span>
      </div>
      <h2
        class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-100 tracking-tight mb-4"
      >
        {lang === "es" ? "Preguntas Frecuentes" : "Frequently Asked Questions"}
      </h2>
      <p class="text-stone-300 text-base sm:text-lg font-light leading-relaxed">
        {
          lang === "es"
            ? "Todo lo que necesitas saber para contratar a la Rondalla San Rafael en Puerto Vallarta."
            : "Everything you need to know when booking Rondalla San Rafael in Puerto Vallarta."
        }
      </p>
    </div>

    <div class="space-y-4 mb-14">
      {
        faqs.map((faq) => (
          <details
            data-faq
            data-state="closed"
            class="group liquid-glass-luthier rounded-2xl border border-stone-800/80 transition-all duration-300 hover:border-amber-400/35 relative overflow-hidden shadow-md data-[state=open]:border-amber-400/50 data-[state=open]:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.7),0_0_28px_-4px_rgba(207,154,72,0.16)]"
          >
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-300/30 to-transparent pointer-events-none" />

            <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer select-none text-left list-none [&::-webkit-details-marker]:hidden">
              <span class="font-serif text-base sm:text-lg font-bold text-stone-100 group-hover:text-amber-300 transition-colors pr-4">
                {faq.question}
              </span>
              <div class="faq-chevron w-8 h-8 rounded-full bg-stone-900/90 border border-stone-800 flex items-center justify-center text-stone-400 group-hover:text-amber-300 group-hover:border-amber-500/40 shrink-0 group-data-[state=open]:text-amber-300 group-data-[state=open]:border-amber-400/50 group-data-[state=open]:bg-amber-500/10">
                <ChevronDown class="w-4 h-4" />
              </div>
            </summary>

            <div class="faq-panel">
              <div class="faq-panel-inner">
                <div class="px-5 sm:px-6 pb-6 pt-1 text-sm sm:text-base text-stone-300 leading-relaxed border-t border-stone-800/50 mt-1 font-light">
                  {faq.answer}
                </div>
              </div>
            </div>
          </details>
        ))
      }
    </div>

    <div class="relative mt-8 sm:mt-12">
      <div
        class="absolute -inset-4 sm:-inset-6 rounded-[32px] pointer-events-none -z-10"
        style="background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(13, 94, 66, 0.35) 0%, rgba(13, 94, 66, 0.12) 45%, transparent 75%); filter: blur(30px); transform: translateZ(0);"
      >
      </div>

      <div
        class="liquid-glass-card rounded-3xl p-6 sm:p-8 text-center flex flex-col sm:flex-row items-center justify-between gap-6 shadow-[0_25px_60px_-10px_rgba(0,0,0,0.9),0_0_35px_-8px_rgba(13,94,66,0.22)] border border-amber-500/30 relative overflow-hidden"
      >
        <div
          class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-300/40 to-transparent pointer-events-none"
        >
        </div>

        <div
          class="absolute -top-12 -left-12 w-40 h-40 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"
        >
        </div>

        <div class="text-center sm:text-left relative z-10">
          <h3 class="font-serif text-xl font-bold text-stone-100 mb-1">
            {
              lang === "es"
                ? "¿Tienes alguna duda en particular?"
                : "Do you have another question?"
            }
          </h3>
          <p class="text-xs sm:text-sm text-stone-300 font-light">
            {
              lang === "es"
                ? "Escríbenos directamente por WhatsApp y te asesoramos al instante para tu evento."
                : "Message us directly on WhatsApp and we will assist you immediately for your event."
            }
          </p>
        </div>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 py-3.5 px-6 rounded-2xl liquid-glass-emerald text-stone-100 font-semibold text-sm transition-all hover:scale-[1.02] active:scale-[0.98] shrink-0 group relative z-10"
        >
          <MessageSquare
            class="w-4 h-4 text-emerald-300 group-hover:scale-110 transition-transform"
          />
          <span class="tracking-wide">
            {lang === "es" ? "Preguntar por WhatsApp" : "Ask on WhatsApp"}
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 380ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms ease;
  }

  .faq-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  details[data-state="open"] .faq-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  details:not([data-js])[open] .faq-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .faq-chevron {
    transition:
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      color 300ms ease,
      border-color 300ms ease,
      background-color 300ms ease;
  }

  details[data-state="open"] .faq-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel,
    .faq-chevron {
      transition: none;
    }
  }
</style>

<script>
  const CLOSE_FALLBACK_MS = 500;

  function initFaqs() {
    const container = document.querySelector("#faq");
    if (!container || container.hasAttribute("data-faq-init")) return;
    container.setAttribute("data-faq-init", "true");

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const items = Array.from(
      container.querySelectorAll<HTMLDetailsElement>("details[data-faq]"),
    );

    items.forEach((details) => {
      details.dataset.js = "true";
      details.dataset.state = details.open ? "open" : "closed";
    });

    function openItem(details: HTMLDetailsElement) {
      delete details.dataset.closing;
      details.open = true;

      if (prefersReducedMotion) {
        details.dataset.state = "open";
        return;
      }

      requestAnimationFrame(() => {
        details.dataset.state = "open";
      });
    }

    function closeItem(details: HTMLDetailsElement) {
      const panel = details.querySelector<HTMLElement>(".faq-panel");
      details.dataset.state = "closed";

      if (prefersReducedMotion || !panel) {
        details.open = false;
        return;
      }

      details.dataset.closing = "true";
      let finished = false;

      const finish = () => {
        if (finished) return;
        finished = true;
        panel.removeEventListener("transitionend", onTransitionEnd);
        window.clearTimeout(timeoutId);

        if (details.dataset.state === "closed") {
          details.open = false;
        }
        delete details.dataset.closing;
      };

      const onTransitionEnd = (event: TransitionEvent) => {
        if (
          event.target === panel &&
          event.propertyName === "grid-template-rows"
        ) {
          finish();
        }
      };

      panel.addEventListener("transitionend", onTransitionEnd);
      const timeoutId = window.setTimeout(finish, CLOSE_FALLBACK_MS);
    }

    container.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const summary = target.closest("summary");
      if (!summary) return;

      const details = summary.closest<HTMLDetailsElement>("details[data-faq]");
      if (!details) return;

      event.preventDefault();
      const isOpen = details.dataset.state === "open";

      if (isOpen) {
        closeItem(details);
      } else {
        items.forEach((item) => {
          if (item !== details && item.dataset.state === "open") {
            closeItem(item);
          }
        });
        openItem(details);
      }
    });
  }

  document.addEventListener("astro:page-load", initFaqs);
  if (document.readyState !== "loading") {
    initFaqs();
  } else {
    document.addEventListener("DOMContentLoaded", initFaqs);
  }
</script>
