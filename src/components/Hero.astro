---
import { MessageCircle, Calendar, Sparkles } from '@lucide/astro';
import { useTranslations } from '../i18n/ui';
import { SITE_CONFIG, getWhatsAppLink } from '../config/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const whatsappUrl = getWhatsAppLink(t('wa.message'));

// Enlace real cargado desde la configuración centralizada del sitio
const facebookUrl = SITE_CONFIG.socials?.facebook || '#';
---

<section class="relative pt-32 pb-24 md:pt-44 md:pb-36 overflow-hidden bg-[#0e0c0b]">
  
  {/* Auras de Iluminación Cálida (Simulando luz de ambiente / faroles) */}
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-amber-600/10 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute top-1/3 -left-20 w-80 h-80 bg-rose-900/15 rounded-full blur-[100px] pointer-events-none"></div>

  {/* Patrón de fondo geométrico inspirado en roseta de guitarra */}
  <div class="absolute inset-0 bg-[radial-gradient(#1f1917_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center relative z-10">
    
    {/* Insignia / Ubicación en estilo Vintage Gold */}
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-300 text-xs sm:text-sm font-medium mb-8 backdrop-blur-md shadow-inner">
      <Sparkles class="w-4 h-4 text-amber-400" />
      <span class="tracking-wide uppercase font-semibold">{SITE_CONFIG.location}</span>
    </div>

    {/* Título Principal Tipográfico Serif */}
    <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-extrabold text-stone-100 tracking-tight leading-[1.12] mb-8">
      {lang === 'es' ? (
        <>
          Música Romántica & <span class="italic font-normal text-amber-400 font-serif">Tradicional</span> para tus Momentos Especiales
        </>
      ) : (
        <>
          Live Romantic & <span class="italic font-normal text-amber-400 font-serif">Traditional</span> Strings for Unforgettable Events
        </>
      )}
    </h1>

    {/* Subtítulo */}
    <p class="text-base sm:text-xl text-stone-300/90 max-w-2xl mx-auto mb-12 leading-relaxed font-light">
      {t('hero.subtitle')}
    </p>

    {/* Botones con estilo artesanal pulido — responsive: móvil apilado, sm en 2 filas, md+ en una fila */}
    <div class="grid grid-cols-1 sm:grid-cols-2 md:flex md:flex-row items-center justify-center gap-5 max-w-lg sm:max-w-xl md:max-w-none mx-auto">

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="sm:col-span-2 w-full md:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-base transition-all shadow-xl shadow-emerald-950/60 hover:scale-[1.02] border border-emerald-400/30"
      >
        <MessageCircle class="w-5 h-5" />
        <span>{t('hero.cta')}</span>
      </a>

      <a
        href="#servicios"
        class="w-full md:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-stone-900/80 hover:bg-stone-800 border border-amber-500/20 text-stone-200 font-medium text-base transition-all hover:border-amber-500/40 backdrop-blur-sm"
      >
        <Calendar class="w-5 h-5 text-amber-400/80" />
        <span>{lang === 'es' ? 'Explorar Servicios' : 'Explore Services'}</span>
      </a>

      {/* Botón de Facebook — cápsula de cristal, a juego con el header */}
      <a
        href={facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="facebook-btn group w-full md:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl liquid-glass-body border border-white/15 text-stone-200 font-medium text-base transition-all hover:scale-[1.02] relative overflow-hidden"
      >
        {/* Reflejo diagonal, igual que el header */}
        <div class="absolute -top-10 -left-8 w-32 h-32 bg-gradient-to-tr from-transparent via-white/10 to-transparent rotate-45 pointer-events-none blur-sm"></div>

        {/* SVG vectorial nativo de Facebook */}
        <svg class="w-5 h-5 text-stone-400 group-hover:text-[#1877F2] transition-colors relative z-10 fill-current" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>

        <span class="relative z-10 group-hover:text-white transition-colors">
          {lang === 'es' ? 'Síguenos' : 'Follow Us'}
        </span>
      </a>
    </div>

  </div>
</section>

<style>
  .liquid-glass-body {
    background: linear-gradient(
      135deg,
      rgba(35, 25, 22, 0.6) 0%,
      rgba(18, 14, 13, 0.8) 50%,
      rgba(10, 8, 7, 0.9) 100%
    );
    backdrop-filter: blur(28px) saturate(190%) contrast(105%);
    -webkit-backdrop-filter: blur(28px) saturate(190%) contrast(105%);
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.25),
      inset 0 -1px 2px 0 rgba(0, 0, 0, 0.8),
      0 15px 35px -5px rgba(0, 0, 0, 0.6);
  }

  /* Glow azul de Facebook solo al hacer hover, sutil y elegante */
  .facebook-btn {
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .facebook-btn:hover {
    border-color: rgba(24, 119, 242, 0.4);
    box-shadow:
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.25),
      inset 0 -1px 2px 0 rgba(0, 0, 0, 0.8),
      0 15px 35px -5px rgba(0, 0, 0, 0.6),
      0 0 24px -4px rgba(24, 119, 242, 0.35);
  }
</style>