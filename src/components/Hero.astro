---
import {
  MessageCircle,
  Calendar,
  Sparkles,
  Music,
} from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { SITE_CONFIG, getWhatsAppLink } from "../config/site";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const whatsappUrl = getWhatsAppLink(t("wa.message"));
---

<section class="relative pt-32 pb-24 md:pt-44 md:pb-36 overflow-hidden">
  {/* Auras de Iluminación de Concierto Nocturno */}
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-amber-600/[0.08] rounded-full blur-[140px] pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/3 -left-24 w-96 h-96 bg-[#8a431d]/[0.09] rounded-full blur-[120px] pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/4 -right-24 w-80 h-80 bg-rose-950/[0.15] rounded-full blur-[130px] pointer-events-none"
  >
  </div>

  {/* Filamentos de Cuerdas de Luz en el Fondo */}
  <div
    class="absolute inset-0 flex justify-around pointer-events-none opacity-[0.035]"
  >
    <div
      class="w-px h-full bg-gradient-to-b from-transparent via-amber-400 to-transparent"
    >
    </div>
    <div
      class="w-px h-full bg-gradient-to-b from-transparent via-amber-300 to-transparent"
    >
    </div>
    <div
      class="w-px h-full bg-gradient-to-b from-transparent via-amber-500 to-transparent"
    >
    </div>
    <div
      class="w-px h-full bg-gradient-to-b from-transparent via-amber-400 to-transparent"
    >
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center relative z-10">
    {/* Insignia / Ubicación */}
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-300 text-xs sm:text-sm font-medium mb-6 backdrop-blur-md shadow-inner"
    >
      <Sparkles class="w-4 h-4 text-amber-400" />
      <span class="tracking-wide uppercase font-semibold"
        >{SITE_CONFIG.location}</span
      >
    </div>

    {/* Título Principal de Gala */}
    <h1
      class="font-serif text-4xl sm:text-6xl md:text-7xl font-extrabold text-stone-100 tracking-tight leading-[1.12] mb-6"
    >
      {
        lang === "es" ? (
          <>
            Música Romántica &{" "}
            <span class="italic font-normal text-amber-400 font-serif">
              Tradicional
            </span>{" "}
            para tus Momentos Especiales
          </>
        ) : (
          <>
            Live Romantic &{" "}
            <span class="italic font-normal text-amber-400 font-serif">
              Traditional
            </span>{" "}
            Strings for Unforgettable Events
          </>
        )
      }
    </h1>

    {/* Subtítulo Poético */}
    <p
      class="text-base sm:text-xl text-stone-300/90 max-w-2xl mx-auto mb-8 leading-relaxed font-light"
    >
      {t("hero.subtitle")}
    </p>

    {/* Botones de Acción con Jerarquía Limpia */}
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-lg sm:max-w-none mx-auto"
    >
      {/* Botón Principal: WhatsApp Esmeralda Joya */}
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl liquid-glass-emerald text-stone-100 font-semibold text-base transition-all hover:scale-[1.02] active:scale-[0.98] group"
      >
        <MessageCircle
          class="w-5 h-5 text-emerald-300 group-hover:scale-110 transition-transform"
        />
        <span class="tracking-wide">{t("hero.cta")}</span>
      </a>

      {/* Botón Secundario: Explorar Repertorio Acústico */}
      <a
        href="#media"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl liquid-glass-luthier text-stone-200 font-medium text-base transition-all hover:border-amber-400/50 hover:text-amber-300 hover:scale-[1.02]"
      >
        <Music class="w-5 h-5 text-amber-400/90" />
        <span
          >{
            lang === "es" ? "Escuchar Repertorio" : "Listen to Repertoire"
          }</span
        >
      </a>

      {/* Botón Terciario: Programa de Concierto */}
      <a
        href="#servicios"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl bg-stone-900/60 hover:bg-stone-800/80 border border-stone-800 text-stone-300 hover:text-white font-medium text-base transition-all"
      >
        <Calendar class="w-5 h-5 text-stone-400" />
        <span>{lang === "es" ? "Ver Servicios" : "View Services"}</span>
      </a>
    </div>
  </div>
</section>
