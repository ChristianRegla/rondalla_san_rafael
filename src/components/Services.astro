---
import { Sparkles, MessageCircle, Heart, Crown, Music3 } from '@lucide/astro';
import { useTranslations } from '../i18n/ui';
import { getWhatsAppLink } from '../config/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    icon: Heart,
    label: lang === 'es' ? 'Serenata' : 'Serenade',
    title: lang === 'es' ? 'Serenata al Pie del Balcón' : 'Balcony Serenade',
    description: lang === 'es'
      ? 'La sorpresa más emotiva: requintos, guitarras y voces en la oscuridad de la noche para una pedida de mano, cumpleaños o aniversario.'
      : 'The most moving surprise: requintos, guitars, and voices under the night sky for a proposal, birthday, or anniversary.',
    highlight: false,
    waText: lang === 'es'
      ? 'Hola, me interesa cotizar una Serenata Tradicional con la Rondalla San Rafael.'
      : 'Hello, I would like to inquire about a Traditional Serenade with Rondalla San Rafael.',
  },
  {
    icon: Crown,
    label: lang === 'es' ? 'Boda & Coctel' : 'Wedding & Cocktail',
    title: lang === 'es' ? 'Enlace Nupcial & Coctel' : 'Wedding & Sunset Cocktail',
    description: lang === 'es'
      ? 'Elegancia acústica frente al mar. 10 a 12 músicos en smoking para la ceremonia, recepción y cena de gala en la Bahía de Banderas.'
      : 'Unrivaled acoustic elegance overlooking Banderas Bay. 10 to 12 musicians in tuxedo for ceremony, cocktail hour, and reception.',
    highlight: true,
    waText: lang === 'es'
      ? 'Hola, me interesa pedir informes para música de Enlace Nupcial con la Rondalla San Rafael.'
      : 'Hello, I would like to inquire about Wedding music with Rondalla San Rafael.',
  },
  {
    icon: Music3,
    label: lang === 'es' ? 'Noche Bohemia' : 'Bohemian Night',
    title: lang === 'es' ? 'Noche de Bohemia Familiar' : 'Bohemian Family Evening',
    description: lang === 'es'
      ? 'Cantar juntos las canciones que han marcado generaciones. Un ambiente cercano, alegre y nostálgico para reuniones, XV años y homenajes.'
      : 'Sing together the timeless songs of Mexico. An intimate and joyful atmosphere for family gatherings, milestones, and celebrations.',
    highlight: false,
    waText: lang === 'es'
      ? 'Hola, me gustaría cotizar una Noche de Bohemia para una reunión familiar.'
      : 'Hello, I would like to inquire about a Bohemian Evening for a family event.',
  },
];
---

<section id="servicios" class="py-28 bg-[#0b0807] border-t border-amber-950/20 relative overflow-hidden">

  {/* Auras de fondo */}
  <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-amber-600/[0.05] rounded-full blur-[140px] pointer-events-none" style="transform: translateZ(0);"></div>
  <div class="absolute bottom-10 right-10 w-80 h-80 bg-[#8a431d]/[0.06] rounded-full blur-[120px] pointer-events-none" style="transform: translateZ(0);"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">

    {/* Encabezado */}
    <div class="text-center max-w-2xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-widest mb-5 backdrop-blur-md">
        <Sparkles class="w-3.5 h-3.5 text-amber-400" />
        <span>{lang === 'es' ? 'Nuestros Servicios' : 'Our Services'}</span>
      </div>
      <h2 class="font-serif text-4xl sm:text-5xl font-extrabold text-stone-100 tracking-tight mb-4 leading-tight">
        {lang === 'es' ? 'Experiencias Acústicas' : 'Acoustic Experiences'}
      </h2>
      <p class="text-stone-400 text-base font-light leading-relaxed">
        {lang === 'es'
          ? 'Cada presentación está diseñada a la medida de tu celebración en Puerto Vallarta y la Riviera Nayarit.'
          : 'Every performance is tailored to your celebration along Banderas Bay and the Riviera Nayarit.'}
      </p>
    </div>

    {/* Tarjetas de servicios */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((service, i) => {
        const waUrl = getWhatsAppLink(service.waText);
        const ServiceIcon = service.icon;

        return (
          <div
            class={`service-card group rounded-3xl p-8 flex flex-col gap-6 border transition-all duration-500 ${
              service.highlight
                ? 'liquid-glass-gold border-amber-400/40 md:-translate-y-3'
                : 'liquid-glass-card border-stone-800/60 hover:border-amber-500/30'
            }`}
            style={`animation-delay: ${i * 100}ms`}
          >
            {/* Ícono */}
            <div class={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 ${
              service.highlight
                ? 'bg-amber-400/20 border border-amber-400/40'
                : 'bg-stone-800/80 border border-stone-700/60 group-hover:border-amber-500/30 transition-colors'
            }`}>
              <ServiceIcon class={`w-5 h-5 ${service.highlight ? 'text-amber-300' : 'text-amber-400'}`} />
            </div>

            {/* Texto */}
            <div class="flex-1">
              <p class={`text-[10px] font-bold uppercase tracking-widest mb-2 ${
                service.highlight ? 'text-amber-300' : 'text-amber-400/70'
              }`}>
                {service.label}
              </p>
              <h3 class="font-serif text-xl font-bold text-stone-100 leading-snug mb-3">
                {service.title}
              </h3>
              <p class="text-sm text-stone-400 leading-relaxed font-light">
                {service.description}
              </p>
            </div>

            {/* Botón */}
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center justify-center gap-2 py-3 px-5 rounded-2xl text-sm font-semibold transition-all hover:scale-[1.02] active:scale-[0.98] ${
                service.highlight
                  ? 'bg-amber-400 hover:bg-amber-300 text-stone-950 shadow-lg shadow-amber-900/40'
                  : 'bg-stone-900/60 hover:bg-stone-800/80 text-stone-200 border border-stone-700/60 hover:border-amber-500/30'
              }`}
            >
              <MessageCircle class="w-4 h-4" />
              <span>{lang === 'es' ? 'Cotizar por WhatsApp' : 'Inquire on WhatsApp'}</span>
            </a>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .service-card {
    animation: fadeSlideUp 0.5s ease both;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* La tarjeta destacada mantiene su elevación en desktop */
  @media (min-width: 768px) {
    .service-card.liquid-glass-gold {
      animation: fadeSlideUpHighlight 0.5s ease both;
    }

    @keyframes fadeSlideUpHighlight {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(-12px);
      }
    }
  }
</style>