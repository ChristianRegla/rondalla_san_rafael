---
import { MessageCircle } from "@lucide/astro";
import { useTranslations } from "../i18n/ui";
import { getWhatsAppLink } from "../config/site";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const whatsappUrl = getWhatsAppLink(t("wa.message"));
---

<div class="fixed bottom-5 right-5 z-50 group" id="whatsapp-fab">
  {/* Tooltip para Escritorio */}
  <div
    class="hidden md:block absolute right-full mr-3 top-1/2 -translate-y-1/2 opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 pointer-events-none"
  >
    <div
      class="liquid-glass-body relative rounded-full pl-3 pr-4 py-2 border border-white/15 shadow-[0_15px_35px_-5px_rgba(0,0,0,0.6)] whitespace-nowrap flex items-center gap-2"
    >
      <span
        class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"
      ></span>
      <span class="text-xs font-medium text-stone-200">
        {lang === "es" ? "¡Cotiza tu evento!" : "Get a quote!"}
      </span>
    </div>
    <div
      class="absolute top-1/2 -right-1 -translate-y-1/2 w-2.5 h-2.5 rotate-45 liquid-glass-body border-t border-r border-white/15"
    >
    </div>
  </div>

  {/* Cápsula Móvil con Texto */}
  <div class="relative rounded-full p-[1px]">
    <div
      class="absolute inset-0 rounded-full bg-gradient-to-b from-white/30 via-emerald-500/10 to-amber-500/20 pointer-events-none"
    >
    </div>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      class="liquid-glass-body relative flex items-center gap-2.5 px-4 py-3 sm:px-0 sm:py-0 sm:w-16 sm:h-16 rounded-full overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.6)] hover:scale-105 active:scale-95 transition-all duration-300 justify-center"
    >
      <div
        class="absolute -top-10 -left-8 w-24 h-24 bg-gradient-to-tr from-transparent via-white/10 to-transparent rotate-45 pointer-events-none blur-sm"
      >
      </div>
      <span class="absolute inset-0 rounded-full pulse-ring pointer-events-none"
      ></span>

      <MessageCircle
        class="w-6 h-6 sm:w-7 sm:h-7 text-emerald-400 relative z-10 drop-shadow-[0_0_6px_rgba(52,211,153,0.5)] shrink-0"
      />
      <span
        class="sm:hidden text-xs font-semibold text-stone-100 tracking-wide pr-1 relative z-10"
      >
        {lang === "es" ? "Cotizar ahora" : "Book now"}
      </span>
    </a>
  </div>
</div>

<style>
  @keyframes pulseRing {
    0% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.35);
    }
    70% {
      box-shadow: 0 0 0 14px rgba(52, 211, 153, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0);
    }
  }
  .pulse-ring {
    animation: pulseRing 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  #whatsapp-fab {
    animation: fabIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }
  #whatsapp-fab.whatsapp-fab-hidden {
    opacity: 0 !important;
    transform: translateY(24px) scale(0.85) !important;
    pointer-events: none !important;
    visibility: hidden;
  }
  @keyframes fabIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
