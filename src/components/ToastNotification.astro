---
import { Music, Sparkles } from "@lucide/astro";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
---

<div
  id="audio-toast"
  class="fixed bottom-24 right-4 left-4 sm:left-6 sm:right-auto sm:bottom-6 z-50 opacity-0 translate-y-6 pointer-events-none transition-all duration-500 max-w-sm mx-auto sm:mx-0"
>
  <div
    class="liquid-glass-gold relative rounded-2xl p-3.5 border border-amber-400/40 shadow-[0_15px_35px_rgba(0,0,0,0.8)] flex items-center gap-3"
  >
    <div
      class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-600 to-amber-400 text-stone-950 flex items-center justify-center shrink-0 shadow-[0_0_12px_rgba(245,158,11,0.5)]"
    >
      <Music class="w-4 h-4" />
    </div>
    <div class="min-w-0 flex-1">
      <span
        class="flex items-center gap-1 text-[10px] font-mono text-amber-300 uppercase tracking-wider"
      >
        <Sparkles class="w-3 h-3 text-amber-400" />
        {lang === "es" ? "Reproduciendo ahora" : "Now Playing"}
      </span>
      <h5
        id="toast-song-title"
        class="font-serif font-bold text-stone-100 text-xs sm:text-sm truncate"
      >
        Canción
      </h5>
    </div>
  </div>
</div>

<script>
  let toastTimeout: number | null = null;

  window.addEventListener("audio-track-change", (e: Event) => {
    const toast = document.getElementById("audio-toast");
    const toastTitle = document.getElementById("toast-song-title");
    const customEvent = e as CustomEvent<{ title: string }>;
    const title = customEvent.detail?.title;

    if (!toast || !toastTitle || !title) return;

    toastTitle.textContent = title;

    // Mostrar Toast
    toast.classList.remove("opacity-0", "translate-y-6", "pointer-events-none");
    toast.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");

    if (toastTimeout !== null) clearTimeout(toastTimeout);

    // Ocultar tras 4 segundos
    toastTimeout = window.setTimeout(() => {
      toast.classList.remove(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto",
      );
      toast.classList.add("opacity-0", "translate-y-6", "pointer-events-none");
    }, 4000);
  });
</script>
