---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

interface Props {
  title?: string;
  lang?: string;
}

const {
  title = "Rondalla San Rafael | Serenatas en Puerto Vallarta",
  lang = "es",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    {/* Componente SEO y Datos Estructurados */}
    <SEO title={title} lang={lang as "es" | "en"} />

    {/* Fuentes Google */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#080403] text-stone-200 antialiased selection:bg-amber-600 selection:text-stone-950 font-sans relative min-h-screen overflow-x-hidden"
  >
    {
      /* Fondo de gradiente estático: reemplaza background-attachment:fixed para evitar repaints en scroll mobile */
    }
    <div
      class="fixed inset-0 -z-30 pointer-events-none"
      style="background-image: radial-gradient(circle at 50% 0%, #1a100c 0%, #0e0806 45%, #070403 100%);"
    >
    </div>

    {/* Textura de grano acústico nativa */}
    <div
      class="fixed inset-0 pointer-events-none opacity-[0.035] z-50 mix-blend-overlay"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.85\' numOctaves=\'3\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\'/%3E%3C/svg%3E'); background-repeat: repeat; contain: strict;"
    >
    </div>

    {/* Auras de resonancia armónica de fondo - Optimizadas */}
    {
      /* Reducimos un poco el tamaño y el blur en móviles para aligerar la GPU */
    }
    <div
      class="fixed top-0 left-1/4 w-[250px] h-[250px] sm:w-[750px] sm:h-[750px] bg-[#cf9a48]/[0.04] sm:bg-[#cf9a48]/[0.055] rounded-full blur-[60px] sm:blur-[180px] pointer-events-none -z-20 will-change-transform translate-z-0"
    >
    </div>

    <div
      class="fixed top-1/3 right-5 sm:right-10 w-[200px] h-[200px] sm:w-[650px] sm:h-[650px] bg-[#8a3a17]/[0.05] sm:bg-[#8a3a17]/[0.065] rounded-full blur-[50px] sm:blur-[160px] pointer-events-none -z-20 will-change-transform translate-z-0"
    >
    </div>

    <div
      class="fixed top-2/3 left-10 sm:left-1/3 w-[250px] h-[250px] sm:w-[800px] sm:h-[800px] bg-[#b0782e]/[0.04] sm:bg-[#b0782e]/[0.05] rounded-full blur-[60px] sm:blur-[190px] pointer-events-none -z-20 will-change-transform translate-z-0"
    >
    </div>

    <div
      class="fixed bottom-0 right-1/4 w-[200px] h-[200px] sm:w-[600px] sm:h-[600px] bg-[#4e1f14]/[0.06] sm:bg-[#4e1f14]/[0.08] rounded-full blur-[50px] sm:blur-[170px] pointer-events-none -z-20 will-change-transform translate-z-0"
    >
    </div>

    <slot />
  </body>
</html>
