---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

interface Props {
  title?: string;
  lang?: string;
}

const {
  title = "Rondalla San Rafael | Serenatas en Puerto Vallarta",
  lang = "es",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    {/* Componente SEO y Datos Estructurados */}
    <SEO title={title} lang={lang as "es" | "en"} />

    {/* Fuentes Google */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#080403] text-stone-200 antialiased selection:bg-amber-600 selection:text-stone-950 font-sans relative min-h-screen overflow-x-hidden"
  >
    {
      /* Fondo de gradiente estático: reemplaza background-attachment:fixed para evitar repaints en scroll mobile */
    }
    <div
      class="fixed inset-0 -z-30 pointer-events-none"
      style="background-image: radial-gradient(circle at 50% 0%, #1a100c 0%, #0e0806 45%, #070403 100%);"
    >
    </div>

    {/* Auras reemplazadas por radial-gradients sin blur */}
    <div
      class="fixed top-0 left-1/4 w-[250px] h-[250px] sm:w-[750px] sm:h-[750px] bg-[radial-gradient(circle_at_center,rgba(207,154,72,0.05)_0%,transparent_70%)] pointer-events-none -z-20"
    >
    </div>

    <div
      class="fixed top-1/3 right-5 sm:right-10 w-[200px] h-[200px] sm:w-[650px] sm:h-[650px] bg-[radial-gradient(circle_at_center,rgba(138,58,23,0.06)_0%,transparent_70%)] pointer-events-none -z-20"
    >
    </div>

    <div
      class="fixed top-2/3 left-10 sm:left-1/3 w-[250px] h-[250px] sm:w-[800px] sm:h-[800px] bg-[radial-gradient(circle_at_center,rgba(176,120,46,0.05)_0%,transparent_70%)] pointer-events-none -z-20"
    >
    </div>

    <div
      class="fixed bottom-0 right-1/4 w-[200px] h-[200px] sm:w-[600px] sm:h-[600px] bg-[radial-gradient(circle_at_center,rgba(78,31,20,0.08)_0%,transparent_70%)] pointer-events-none -z-20"
    >
    </div>

    <slot />
  </body>
</html>
